@using IdentityManagementSystem.UI.Areas.Security.Models
@model ForgotPasswordStartViewModel
@{
    ViewData["Title"] = "بازنشانی رمز عبور";
    Layout = "~/Areas/Security/Views/Shared/_LayoutAuth.cshtml";
}

<style>
    .otp-input-group {
        direction: ltr;
        display: flex;
        justify-content: center;
        gap: .5rem;
    }

    .otp-input-group .otp-input {
        width: 2.5rem;
        height: 2.75rem;
        flex: 0 0 2.5rem;
        padding-inline: .25rem;
    }

    #resendCode.is-disabled {
        color: var(--text-muted) !important;
        pointer-events: none;
        cursor: default;
        text-decoration: none;
    }
</style>

@Html.AntiForgeryToken()
<input type="hidden" id="resetToken" />

<div class="col-xl-11">
    <div class="row justify-content-center">
        <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-6 col-sm-8 col-12">
            <div class="mt-5 mb-1 d-flex justify-content-center">
                <a href="/Security/Account/Login">
                    <img src="~/assets/images/brand-logos/logo-pmo.png" alt="" class="authentication-brand desktop-logo" style="max-width:180px;">
                </a>
            </div>
            <div class="text-start">
                <a class="fs-15 text-primary"
                   asp-area="Security"
                   asp-controller="Account"
                   asp-action="Login">
                    <i class="ti ti-arrow-right"></i>
                    بازگشت به صفحه ورود
                </a>
            </div>
            <div class="card custom-card my-4">
                <div class="card-body p-5">

                    <!-- مرحله ۱ -->
                    <div id="step1">
                        <p class="h4 mb-2 fw-semibold">بازنشانی رمز عبور</p>
                        <p class="mb-4 text-muted fw-normal">
                            جهت احراز هویت، کدملی و شماره همراه ثبت‌شده خود را وارد کنید.
                        </p>
                        <div class="row gy-3">
                            <div class="col-xl-12">
                                <label class="form-label text-default">کدملی</label>
                                <input class="form-control form-control-lg" id="nationalId" placeholder="کدملی" inputmode="numeric" type="text" maxlength="10" autocomplete="off" value="@Model.NationalId" required aria-describedby="nationalIdError">
                                <div class="invalid-feedback" id="nationalIdError">کد ملی الزامی است.</div>
                            </div>
                            <div class="col-xl-12">
                                <label class="form-label text-default">شماره همراه</label>
                                <input class="form-control form-control-lg" id="mobile" placeholder="09xxxxxxxxx" inputmode="numeric" type="text" maxlength="11" autocomplete="off" value="@Model.MobileNumber" required aria-describedby="mobileError">
                                <div class="invalid-feedback" id="mobileError">شماره همراه الزامی است.</div>
                            </div>
                            <div class="col-xl-12 d-grid mt-3">
                                <button class="btn btn-lg btn-primary" type="button" id="btnStep1">
                                    <span>ادامه</span>
                                    <span class="spinner-border spinner-border-sm ms-2 d-none"></span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- مرحله ۲ -->
                    <div id="step2" class="d-none">
                        <p class="h4 mb-2 fw-semibold">تأیید کد ارسال‌شده </p>
                        <p class="mb-4 text-muted fw-normal">
                            کد ۵ رقمی ارسال‌شده به شماره همراه خود را وارد کنید.
                        </p>
                        <div class="row gy-3">
                            <div class="col-xl-12 mb-2">
                                <div class="otp-input-group">
                                    <div>
                                        <input class="form-control form-control-lg text-center otp-input" id="one" maxlength="1" onkeyup="clickEvent(this,'two')" inputmode="numeric" type="text" autocomplete="off">
                                    </div>
                                    <div>
                                        <input class="form-control form-control-lg text-center otp-input" id="two" maxlength="1" onkeyup="clickEvent(this,'three')" inputmode="numeric" type="text" autocomplete="off">
                                    </div>
                                    <div>
                                        <input class="form-control form-control-lg text-center otp-input" id="three" maxlength="1" onkeyup="clickEvent(this,'four')" inputmode="numeric" type="text" autocomplete="off">
                                    </div>
                                    <div>
                                        <input class="form-control form-control-lg text-center otp-input" id="four" maxlength="1" onkeyup="clickEvent(this,'five')" inputmode="numeric" type="text" autocomplete="off">
                                    </div>
                                    <div>
                                        <input class="form-control form-control-lg text-center otp-input" id="five" maxlength="1" inputmode="numeric" type="text" autocomplete="off">
                                    </div>
                                </div>
                                <div class="mt-3 text-center">
                                    <div class="fw-medium fs-13 mb-1" id="otpCountdown">زمان باقی‌مانده: ۰۰:۰۰</div>
                                    <span class="fw-normal fs-13">کدی دریافت نکردید؟</span>
                                    <a class="text-primary ms-2 d-inline-block fw-medium" id="resendCode" href="javascript:void(0);">ارسال مجدد</a>
                                </div>
                            </div>
                            <div class="col-xl-12 d-grid mt-3">
                                <button class="btn btn-lg btn-primary" type="button" id="btnStep2">
                                    <span>تأیید</span>
                                    <span class="spinner-border spinner-border-sm ms-2 d-none"></span>
                                </button>
                            </div>
                        </div>
                        <div class="text-center">
                            <p class="fs-13 text-danger mt-3 mb-0">
                                <i class="ti ti-alert-circle"></i>
                                کد تأیید را با کسی به اشتراک نگذارید!
                            </p>
                        </div>
                    </div>

                    <!-- مرحله ۳ -->
                    <div id="step3" class="d-none">
                        <p class="h4 mb-2 fw-semibold">بازنشانی رمز عبور</p>
                        <p class="mb-4 text-muted fw-normal">
                            رمز عبور جدید خود را وارد و تأیید کنید.
                        </p>
                        <div class="row gy-3">
                            <div class="col-xl-12">
                                <label class="form-label text-default">رمز عبور جدید</label>
                                <div class="input-group">
                                    <input class="form-control form-control-lg" id="newPassword" placeholder="رمز عبور جدید" type="password" autocomplete="new-password">
                                    <span class="input-group-text" style="cursor:pointer;" onclick="toggleForgotPasswordVisibility('newPassword', this)">
                                        <i class="ti ti-eye-off"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="col-xl-12">
                                <label class="form-label text-default">تأیید رمز عبور</label>
                                <div class="input-group">
                                    <input class="form-control form-control-lg" id="confirmPassword" placeholder="تأیید رمز عبور" type="password" autocomplete="new-password">
                                    <span class="input-group-text" style="cursor:pointer;" onclick="toggleForgotPasswordVisibility('confirmPassword', this)">
                                        <i class="ti ti-eye-off"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="col-xl-12 d-grid mt-3">
                                <button class="btn btn-lg btn-primary" type="button" id="btnStep3">
                                    <span>ثبت رمز جدید</span>
                                    <span class="spinner-border spinner-border-sm ms-2 d-none"></span>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    let otpTimerId = null;
    let resendInProgress = false;

    function showToast(msg, isSuccess) {
        Toastify({
            text: msg,
            duration: 3500,
            gravity: "top",
            position: "left",
            style: { background: isSuccess ? "#22c55e" : "#ef4444" }
        }).showToast();
    }

    function setBusy(buttonId, isBusy) {
        const btn = document.getElementById(buttonId);
        const spinner = btn.querySelector('.spinner-border');
        btn.disabled = isBusy;
        if (spinner) spinner.classList.toggle('d-none', !isBusy);
    }

    function postJson(url, data) {
        return $.ajax({
            url: url,
            type: 'POST',
            data: data,
            dataType: 'json',
            headers: { 'RequestVerificationToken': token }
        });
    }

    function normalizeResponse(res) {
        if (typeof res === 'string') {
            try {
                return JSON.parse(res);
            } catch {
                return { success: false, message: res };
            }
        }
        return res || {};
    }

    function getIdentity() {
        return {
            nationalId: document.getElementById('nationalId').value.trim(),
            mobileNumber: document.getElementById('mobile').value.trim()
        };
    }

    function setFieldError(inputId, errorId, message) {
        const input = document.getElementById(inputId);
        const error = document.getElementById(errorId);
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
        error.textContent = message;
    }

    function clearFieldError(inputId) {
        const input = document.getElementById(inputId);
        input.classList.remove('is-invalid');
    }

    function validateStep1Identity(data) {
        let isValid = true;

        clearFieldError('nationalId');
        clearFieldError('mobile');

        if (!data.nationalId) {
            setFieldError('nationalId', 'nationalIdError', 'کد ملی الزامی است.');
            isValid = false;
        } else if (!/^\d{10}$/.test(data.nationalId)) {
            setFieldError('nationalId', 'nationalIdError', 'کد ملی باید ۱۰ رقم باشد.');
            isValid = false;
        }

        if (!data.mobileNumber) {
            setFieldError('mobile', 'mobileError', 'شماره همراه الزامی است.');
            isValid = false;
        } else if (!/^09\d{9}$/.test(data.mobileNumber)) {
            setFieldError('mobile', 'mobileError', 'شماره همراه باید با 09 شروع شود و ۱۱ رقم باشد.');
            isValid = false;
        }

        return isValid;
    }

    function getCode() {
        return ['one', 'two', 'three', 'four', 'five']
            .map(id => document.getElementById(id).value.trim())
            .join('');
    }

    function toPersianDigits(value) {
        return value.toString().replace(/\d/g, digit => '۰۱۲۳۴۵۶۷۸۹'[digit]);
    }

    function formatDuration(seconds) {
        const minutes = Math.floor(seconds / 60).toString().padStart(2, '0');
        const remainingSeconds = (seconds % 60).toString().padStart(2, '0');
        return toPersianDigits(`${minutes}:${remainingSeconds}`);
    }

    function setResendEnabled(isEnabled) {
        const resend = document.getElementById('resendCode');
        resend.classList.toggle('is-disabled', !isEnabled);
        resend.setAttribute('aria-disabled', (!isEnabled).toString());
    }

    function startOtpCountdown(expiresInSeconds) {
        const countdown = document.getElementById('otpCountdown');
        let remainingSeconds = Number.parseInt(expiresInSeconds, 10);

        if (!Number.isFinite(remainingSeconds) || remainingSeconds <= 0) {
            remainingSeconds = 300;
        }

        if (otpTimerId) {
            clearInterval(otpTimerId);
        }

        setResendEnabled(false);
        countdown.textContent = `زمان باقی‌مانده: ${formatDuration(remainingSeconds)}`;

        otpTimerId = setInterval(function () {
            remainingSeconds -= 1;
            countdown.textContent = `زمان باقی‌مانده: ${formatDuration(Math.max(remainingSeconds, 0))}`;

            if (remainingSeconds <= 0) {
                clearInterval(otpTimerId);
                otpTimerId = null;
                setResendEnabled(true);
            }
        }, 1000);
    }

    function goToStep(stepNumber) {
        ['step1', 'step2', 'step3'].forEach(id => document.getElementById(id).classList.add('d-none'));
        document.getElementById('step' + stepNumber).classList.remove('d-none');
    }

    function clickEvent(first, last) {
        if (first.value.length) document.getElementById(last).focus();
    }

    function toggleForgotPasswordVisibility(id, el) {
        var input = document.getElementById(id);
        var icon = el.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace('ti-eye-off', 'ti-eye');
        } else {
            input.type = "password";
            icon.classList.replace('ti-eye', 'ti-eye-off');
        }
    }

    function requestForgotPasswordCode(options) {
        const shouldMoveToStep2 = options?.shouldMoveToStep2 ?? false;
        const busyButtonId = options?.busyButtonId;
        const data = getIdentity();

        if (!validateStep1Identity(data)) {
            resendInProgress = false;
            setResendEnabled(true);
            return;
        }

        if (busyButtonId) {
            setBusy(busyButtonId, true);
        }

        postJson('/Security/Account/StartForgotPassword', data)
            .done(function (res) {
                res = normalizeResponse(res);
                if (res.success) {
                    showToast(res.message, true);
                    startOtpCountdown(res.expiresInSeconds);
                    document.querySelectorAll('.otp-input').forEach(input => input.value = '');

                    if (shouldMoveToStep2) {
                        goToStep(2);
                    }

                    document.getElementById('one').focus();
                } else {
                    showToast(res.message || 'امکان ارسال کد تأیید وجود ندارد.', false);
                    if (!busyButtonId) {
                        setResendEnabled(true);
                    }
                }
            })
            .fail(function () {
                showToast('خطای سرور', false);
                if (!busyButtonId) {
                    setResendEnabled(true);
                }
            })
            .always(function () {
                if (busyButtonId) {
                    setBusy(busyButtonId, false);
                }
                resendInProgress = false;
            });
    }

    document.querySelectorAll('.otp-input, #nationalId, #mobile').forEach(input => {
        input.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '');
            if (this.id === 'nationalId' || this.id === 'mobile') {
                clearFieldError(this.id);
            }
        });
    });

    document.getElementById('btnStep1').addEventListener('click', function () {
        requestForgotPasswordCode({ shouldMoveToStep2: true, busyButtonId: 'btnStep1' });
    });

    document.getElementById('resendCode').addEventListener('click', function (event) {
        event.preventDefault();
        if (this.classList.contains('is-disabled') || resendInProgress) {
            return;
        }

        resendInProgress = true;
        setResendEnabled(false);
        requestForgotPasswordCode({ shouldMoveToStep2: false });
    });

    document.getElementById('btnStep2').addEventListener('click', function () {
        const data = getIdentity();
        data.code = getCode();

        if (!/^\d{5}$/.test(data.code)) {
            showToast('کد پنج رقمی را کامل وارد کنید.', false);
            return;
        }

        setBusy('btnStep2', true);
        postJson('/Security/Account/VerifyForgotPasswordCode', data)
            .done(function (res) {
                if (res.success && res.resetToken) {
                    document.getElementById('resetToken').value = res.resetToken;
                    showToast(res.message || 'کد تأیید شد.', true);
                    goToStep(3);
                    document.getElementById('newPassword').focus();
                } else {
                    showToast(res.message || 'کد تأیید نامعتبر است.', false);
                }
            })
            .fail(function () {
                showToast('خطای سرور', false);
            })
            .always(function () {
                setBusy('btnStep2', false);
            });
    });

    document.getElementById('btnStep3').addEventListener('click', function () {
        const data = {
            resetToken: document.getElementById('resetToken').value,
            newPassword: document.getElementById('newPassword').value,
            confirmNewPassword: document.getElementById('confirmPassword').value
        };

        if (data.newPassword !== data.confirmNewPassword) {
            showToast('رمز عبور و تأیید آن یکسان نیستند.', false);
            return;
        }

        if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$/.test(data.newPassword)) {
            showToast('رمز عبور باید حداقل ۸ کاراکتر و شامل حرف بزرگ، حرف کوچک، عدد و نویسه خاص باشد.', false);
            return;
        }

        setBusy('btnStep3', true);
        postJson('/Security/Account/ResetForgotPassword', data)
            .done(function (res) {
                if (res.success) {
                    showToast(res.message || 'رمز عبور با موفقیت تغییر کرد.', true);
                    setTimeout(function () { window.location.href = res.redirectUrl || '/Security/Account/Login'; }, 1200);
                } else {
                    showToast(res.message || 'امکان ثبت رمز جدید وجود ندارد.', false);
                }
            })
            .fail(function () {
                showToast('خطای سرور', false);
            })
            .always(function () {
                setBusy('btnStep3', false);
            });
    });

    document.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter') {
            return;
        }

        const target = event.target;
        if (!(target instanceof HTMLInputElement)) {
            return;
        }

        const activeStep = ['step1', 'step2', 'step3']
            .find(stepId => !document.getElementById(stepId).classList.contains('d-none'));

        if (!activeStep) {
            return;
        }

        event.preventDefault();

        const stepButtonMap = {
            step1: 'btnStep1',
            step2: 'btnStep2',
            step3: 'btnStep3'
        };

        const button = document.getElementById(stepButtonMap[activeStep]);
        if (button && !button.disabled) {
            button.click();
        }
    });
</script>
