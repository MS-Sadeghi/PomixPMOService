@{
    ViewData["Title"] = "داشبورد";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var displayName = User?.Identity?.IsAuthenticated == true
        ? User.Identity.Name
        : "همکار گرامی";
}

<style>
    /* ===== Welcome / organization banner ===== */
    .welcome-banner {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        padding: 1.75rem 2rem;
        background: linear-gradient(135deg, #2e3a8c 0%, #4d5fe3 55%, #6c7ff0 100%);
        color: #fff;
    }

        .welcome-banner::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 90% 10%, rgba(255, 255, 255, .12) 0, transparent 45%), radial-gradient(circle at 10% 100%, rgba(255, 255, 255, .08) 0, transparent 40%);
            pointer-events: none;
        }

    .welcome-banner-logo {
        width: 64px;
        height: 64px;
        border-radius: .85rem;
        background: rgba(255, 255, 255, .16);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        backdrop-filter: blur(2px);
        overflow: hidden;
    }

    .welcome-banner h4 {
        color: #fff;
        margin-bottom: .35rem;
    }

    .welcome-banner p {
        color: rgba(255, 255, 255, .85);
        margin-bottom: 0;
        max-width: 640px;
    }

    .welcome-banner .org-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem 1.5rem;
        margin-top: 1rem;
        position: relative;
        z-index: 1;
    }

    .welcome-banner .org-meta-item {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-size: .8rem;
        color: rgba(255, 255, 255, .9);
    }

        .welcome-banner .org-meta-item svg {
            width: 15px;
            height: 15px;
        }

    /* ===== Section label above the service cards ===== */
    .section-label {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin: 1.75rem 0 1rem;
    }

        .section-label .line {
            flex: 1;
            height: 1px;
            background: #eef0f5;
        }

        .section-label span {
            font-size: .9rem;
            font-weight: 600;
            color: #495057;
            white-space: nowrap;
        }

    /* ===== Service cards ===== */
    .dashboard-service-card {
        background: #ffffff;
        border: 1px solid #eef0f5;
        border-radius: 14px;
        box-shadow: 0 4px 12px rgba(0,0,0,.05);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .dashboard-service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0,0,0,.10);
        }

    .dashboard-card-image {
        height: 155px;
        width: 100%;
        object-fit: cover;
    }

    .dashboard-service-card .feature {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .dashboard-service-card .feature svg {
            width: 23px;
            height: 23px;
        }

    .dashboard-btn-icon {
        width: 16px;
        height: 16px;
    }

    [dir="rtl"] .dashboard-service-card .me-3 {
        margin-left: 1rem !important;
        margin-right: 0 !important;
    }

    [dir="rtl"] .dashboard-service-card .ms-2 {
        margin-right: 0.5rem !important;
        margin-left: 0 !important;
    }

    .services-wrapper {
        background: #fff;
        border-radius: 18px;
        padding: 24px;
        margin-top: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,.05);
    }
</style>

<!-- Welcome + organizational info -->
<div class="welcome-banner">
    <div class="d-flex align-items-start">
        <div class="welcome-banner-emblem me-3">
            <img src="~/assets/images/brand/logo1.png"
                 class="welcome-banner-logo" />
        </div>
        <div>
            <h4> @displayName به پرتال داخلی مجتمع بندری شهید رجایی خوش آمدید</h4>
            <p>
                این سامانه، درگاه واحد دسترسی به خدمات الکترونیک اداره کل بنادر و دریانوردی هرمزگان و
                دفتر مدیریت پروژه (PMO) بندر شهید رجایی است.
            </p>

                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <a href="/Home/SrvInformationGuesthouses">
                                        <div class="card kb-hover">
                                            <div class="card-content">
                                                <div class="card-body text-center p-1">

                                                    <div class=" mb-1">
                                                        <img width="80px" src="/app-assets/images/logo/hotel.png">
                                                    </div>
                                                    <h6 class="text-bold-600">اماکن اقامتی</h6>

                        <div>
                            <h5 class="card-title mb-1">گزارش‌های سیستم تردد</h5>
                            <span class="text-muted fs-12">سامانه کنترل ورود و خروج</span>
                        </div>
                    </div>

                    <p class="card-text text-muted">
                        گزارش‌های ورود، خروج، تردد کارکنان و اطلاعات ثبت‌شده را مشاهده و دریافت کنید.
                    </p>

                    <a asp-area="AccessControlReports"
                       asp-controller="Report"
                       asp-action="Dashboard"
                       class="btn btn-primary d-inline-flex align-items-center">
                        ورود به گزارش‌ها
                        <i data-feather="arrow-left" class="ms-2 dashboard-btn-icon"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card overflow-hidden dashboard-service-card h-100">
                <img src="~/assets/images/media/9.jpg"
                     class="card-img-top dashboard-card-image"
                     alt="احراز سند قوه قضائیه">

                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="feature bg-success-transparent rounded-3 me-3">
                            <i data-feather="shield" class="text-success"></i>
                        </div>

                        <div>
                            <h5 class="card-title mb-1">احراز سند قوه قضائیه</h5>
                            <span class="text-muted fs-12">پیگیری و بررسی استعلام اسناد</span>
                        </div>
                    </div>

                    <p class="card-text text-muted">
                        درخواست‌های احراز سند را بررسی کنید و وضعیت استعلام‌های ثبت‌شده را پیگیری نمایید.
                    </p>

                    <a asp-area="JudiciaryInquiry"
                       asp-controller="Cartable"
                       asp-action="Index"
                       class="btn btn-success d-inline-flex align-items-center">
                        ورود به سامانه
                        <i data-feather="arrow-left" class="ms-2 dashboard-btn-icon"></i>
                    </a>
                </div>
            </div>
        </div>

        <!--
            برای افزودن سامانه جدید، این کارت را کپی کرده و مقادیر زیر را جایگزین کنید:
            - آدرس تصویر (~/assets/images/media/...)
            - آیکون feather و رنگ کارت (primary / success / warning / danger / info)
            - عنوان، توضیح کوتاه و لینک asp-area/asp-controller/asp-action
        -->
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof feather !== "undefined") {
                feather.replace();
            }
        });
    </script>
}
