@using IdentityManagementSystem.UI.Areas.AccessControlReports.ViewModel
@model GetSumReportPageViewModel
@{
    ViewData["Title"] = "گزارش تجمیعی تردد";
}
<link rel="stylesheet" href="~/assets/libs/gridjs/theme/mermaid.min.css" />
<style>
    .gridjs-table {
        table-layout: fixed;
        width: 100%;
    }

        .gridjs-table th, .gridjs-table td {
            text-align: center !important;
            vertical-align: middle !important;
        }

            .gridjs-table th:first-child, .gridjs-table td:first-child {
                width: 80px;
            }

            .gridjs-table th:nth-child(2), .gridjs-table td:nth-child(2) {
                width: 150px;
            }

            .gridjs-table th:nth-child(3), .gridjs-table td:nth-child(3) {
                width: auto;
            }

            .gridjs-table th:last-child, .gridjs-table td:last-child {
                width: 120px;
            }

    .gridjs-pagination {
        justify-content: flex-start !important;
    }

        .gridjs-pagination .gridjs-summary {
            margin-right: 0;
            margin-left: auto;
        }

    .expand-btn {
        background: none;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        color: #495057;
        padding: 0;
        margin: 0 auto;
    }

        .expand-btn:hover {
            background: #e9ecef;
            border-color: #adb5bd;
        }

        .expand-btn.expanded {
            background: #0d6efd;
            border-color: #0d6efd;
            color: white;
        }

    .detail-row td {
        padding: 0 !important;
        background-color: #f8f9fa;
    }

    .detail-content {
        padding: 15px 20px;
        text-align: right;
        border-top: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }

        .detail-content p {
            margin: 0 0 5px 0;
        }

    #customExportButtons {
        margin-bottom: 1rem;
    }

    #grid-loading {
        text-align: center;
        padding: 15px 0;
        display: none;
    }

        #grid-loading.show {
            display: block;
        }

        #grid-loading .spinner-border {
            width: 2.5rem;
            height: 2.5rem;
        }

        #grid-loading .loading-text {
            margin-top: 8px;
            font-size: 15px;
            color: #495057;
        }

    #printArea {
        display: none;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        #printArea, #printArea * {
            visibility: visible !important;
        }

        @@page {
            size: landscape;
            margin: 12mm 10mm;
        }

        #printArea {
            display: block !important;
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            width: 100%;
            direction: rtl;
            font-family: Tahoma, Arial, sans-serif;
            color: #1f2937;
        }

            #printArea .print-header {
                display: flex !important;
                align-items: baseline;
                justify-content: space-between;
                border-bottom: 2px solid #333;
                padding-bottom: 10px;
                margin-bottom: 14px;
            }

                #printArea .print-header h4 {
                    margin: 0;
                    font-size: 18px;
                    font-weight: 700;
                }

                #printArea .print-header .print-date {
                    font-size: 12px;
                    color: #555;
                }

            #printArea .print-meta {
                font-size: 12.5px;
                color: #333;
                margin-bottom: 16px;
                background: #f8f9fa;
                border: 1px solid #ddd;
                border-radius: 6px;
                padding: 10px 14px;
            }

                #printArea .print-meta div {
                    display: flex !important;
                    gap: 6px;
                    margin-bottom: 5px;
                }

                    #printArea .print-meta div:last-child {
                        margin-bottom: 0;
                    }

                #printArea .print-meta .meta-label {
                    font-weight: 700;
                    color: #111;
                    white-space: nowrap;
                }

            #printArea table {
                width: 100%;
                border-collapse: collapse;
                font-size: 12px;
            }

            #printArea th, #printArea td {
                border: 1px solid #ccc;
                padding: 6px 8px;
                text-align: center;
                word-break: break-word;
                overflow-wrap: break-word;
            }

            #printArea th {
                background: #f1f3f5;
                font-weight: 700;
            }

            #printArea tbody tr:nth-child(even) {
                background: #fafafa;
            }

            #printArea .print-footer {
                margin-top: 14px;
                font-size: 11px;
                color: #777;
                text-align: center;
            }
    }
</style>
@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="col-xl-12">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
<div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">گزارش‌ها</a></li>
                <li aria-current="page" class="breadcrumb-item active">گزارش تجمیعی تردد</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title">گزارش تجمیعی تردد</div>
    </div>
    <div class="card-body">
        <form id="reportForm">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">از تاریخ</label>
                    <div class="input-group">
                        <span class="input-group-text" id="startDateIcon" style="cursor:pointer;"><i class="ti ti-calendar"></i></span>
                        <input name="StartDate" class="form-control fc-datepicker" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">تا تاریخ</label>
                    <div class="input-group">
                        <span class="input-group-text" id="endDateIcon" style="cursor:pointer;"><i class="ti ti-calendar"></i></span>
                        <input name="EndDate" class="form-control fc-datepicker" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">از ساعت</label>
                    <input name="StartTime" type="time" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">تا ساعت</label>
                    <input name="EndTime" type="time" class="form-control" />
                </div>
                <div class="col-md-12 text-end">
                    <button type="button" id="btnSearch" class="btn btn-primary"><i class="ti ti-search"></i> دریافت گزارش</button>
                </div>
            </div>
        </form>
        <hr />
        <div id="errorBox" class="alert alert-danger d-none"></div>
        <div id="customExportButtons" class="btn-group mb-3 d-none">
            <button class="btn btn-info-light" id="btnPrint"><i class="ti ti-printer"></i> پرینت</button>
            <button class="btn btn-info-light" id="btnExcel"><i class="ti ti-file-spreadsheet"></i> اکسل</button>
        </div>

        <div id="summaryCards" class="row g-2 mb-3 d-none">
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">مجموع ورود کامیون‌ها</div>
                    <div class="fs-16 fw-semibold mb-1" id="sum_truckEntrance">0</div>
                    <span class="badge bg-warning-transparent fs-12" id="sum_truckEntrance_transit">ترانزیت: 0</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">خروج خالی کامیون</div>
                    <div class="fs-16 fw-semibold mb-1" id="sum_truckEmptyExit">0</div>
                    <span class="badge bg-warning-transparent fs-12" id="sum_truckEmptyExit_transit">ترانزیت: 0</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">خروج پر کامیون</div>
                    <div class="fs-16 fw-semibold mb-1" id="sum_truckLoadedExit">0</div>
                    <span class="badge bg-warning-transparent fs-12" id="sum_truckLoadedExit_transit">ترانزیت: 0</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">ورود سواری</div>
                    <div class="fs-16 fw-semibold" id="sum_carEntrance">0</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">خروج سواری</div>
                    <div class="fs-16 fw-semibold" id="sum_carExit">0</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">ورود نفرو</div>
                    <div class="fs-16 fw-semibold" id="sum_pedestrianEntrance">0</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded-3 p-2 text-center h-100">
                    <div class="fs-11 text-muted mb-1">خروج نفرو</div>
                    <div class="fs-16 fw-semibold" id="sum_pedestrianExit">0</div>
                </div>
            </div>
        </div>

        <div id="grid-loading">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div>
            <div class="loading-text">در حال دریافت اطلاعات ...</div>
        </div>
        <div class="table-responsive">
            <div id="grid-report"></div>
        </div>
        <div id="printArea"></div>
    </div>
</div>

@section Scripts
{
    <script>
        let gridInstance = null;
        let gridData = [];
        let rawDaily = [];
        let dailyByDate = new Map();
        let totalPeriodData = null;
        const reportHeaders = ['ردیف', 'تاریخ گزارش', 'مجموع ورود کامیون‌ها', 'خروج خالی کامیون', 'خروج پر کامیون', 'ورود سواری', 'خروج سواری', 'ورود نفرو', 'خروج نفرو'];
        const categoryDefs = [
            { key: 'truckEntrance', label: 'مجموع ورود کامیون‌ها', hasTransit: true },
            { key: 'truckEmptyExit', label: 'خروج خالی کامیون', hasTransit: true },
            { key: 'truckLoadedExit', label: 'خروج پر کامیون', hasTransit: true },
            { key: 'carEntrance', label: 'ورود سواری' },
            { key: 'carExit', label: 'خروج سواری' },
            { key: 'pedestrianEntrance', label: 'ورود نفرو' },
            { key: 'pedestrianExit', label: 'خروج نفرو' }
        ];

        function catTransit(stat) {
            return (stat && typeof stat.transit === 'number') ? stat.transit : 0;
        }

        function catTotal(stat) {
            return (stat && typeof stat.total === 'number') ? stat.total : 0;
        }

        function fmt(n) {
            return (n || 0).toLocaleString('fa-IR');
        }

        function padDate(d) {
            if (!d) return d;
            let p = d.split('/');
            return p[0] + '/' + p[1].padStart(2, '0') + '/' + p[2].padStart(2, '0');
        }

        function getPersianDate() {
            const formatter = new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: '2-digit', day: '2-digit' });
            return formatter.format(new Date()).replace(/\//g, '/');
        }

        function getPersianDateTime() {
            const now = new Date();
            const time = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
            return getPersianDate() + ' - ' + time;
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function getReportMeta() {
            return {
                title: 'گزارش تجمیعی تردد',
                items: [
                    { label: 'بازه تاریخ', value: $("input[name='StartDate']").val() + ' تا ' + $("input[name='EndDate']").val() },
                    { label: 'بازه ساعت', value: $("input[name='StartTime']").val() + ' تا ' + $("input[name='EndTime']").val() },
                    { label: 'تعداد روز', value: fmt(rawDaily.length) },
                    { label: 'تاریخ و ساعت تهیه گزارش', value: getPersianDateTime() }
                ]
            };
        }

        function getReportRows() {
            const rows = rawDaily.map((item, i) => [
                i + 1,
                item.reportDate || '',
                fmt(catTotal(item.truckEntrance)),
                fmt(catTotal(item.truckEmptyExit)),
                fmt(catTotal(item.truckLoadedExit)),
                fmt(catTotal(item.carEntrance)),
                fmt(catTotal(item.carExit)),
                fmt(catTotal(item.pedestrianEntrance)),
                fmt(catTotal(item.pedestrianExit))
            ]);

            if (totalPeriodData) {
                rows.push([
                    'جمع کل',
                    '',
                    fmt(catTotal(totalPeriodData.truckEntrance)),
                    fmt(catTotal(totalPeriodData.truckEmptyExit)),
                    fmt(catTotal(totalPeriodData.truckLoadedExit)),
                    fmt(catTotal(totalPeriodData.carEntrance)),
                    fmt(catTotal(totalPeriodData.carExit)),
                    fmt(catTotal(totalPeriodData.pedestrianEntrance)),
                    fmt(catTotal(totalPeriodData.pedestrianExit))
                ]);
            }

            return rows;
        }

        function renderPrintArea(meta, headers, rows) {
            let html = '<div class="print-header">';
            html += '<h4>' + escapeHtml(meta.title) + '</h4>';
            html += '<div class="print-date">تاریخ چاپ: ' + escapeHtml(getPersianDateTime()) + '</div>';
            html += '</div>';

            html += '<div class="print-meta">';
            meta.items.forEach(item => {
                html += '<div><span class="meta-label">' + escapeHtml(item.label) + ':</span><span>' + escapeHtml(item.value) + '</span></div>';
            });
            html += '</div>';

            html += '<table><thead><tr>';
            headers.forEach(h => { html += '<th>' + escapeHtml(h) + '</th>'; });
            html += '</tr></thead><tbody>';
            rows.forEach(row => {
                html += '<tr>';
                row.forEach(cell => { html += '<td>' + escapeHtml(cell) + '</td>'; });
                html += '</tr>';
            });
            html += '</tbody></table>';


            document.getElementById('printArea').innerHTML = html;
        }

        function exportToExcel(filename, meta, headers, rows) {
            if (typeof XLSX === 'undefined') return;

            const aoa = [[meta.title]];
            meta.items.forEach(item => aoa.push([item.label + ': ' + item.value]));
            aoa.push([]);
            aoa.push(headers);
            rows.forEach(r => aoa.push(r));

            const ws = XLSX.utils.aoa_to_sheet(aoa);
            ws['!cols'] = headers.map(() => ({ wch: 24 }));
            ws['!merges'] = [
                { s: { r: 0, c: 0 }, e: { r: 0, c: headers.length - 1 } },
                ...meta.items.map((_, i) => ({ s: { r: i + 1, c: 0 }, e: { r: i + 1, c: headers.length - 1 } }))
            ];

            const wb = XLSX.utils.book_new();
            wb.Workbook = { Views: [{ RTL: true }] };
            XLSX.utils.book_append_sheet(wb, ws, meta.title.slice(0, 31));

            XLSX.writeFile(wb, filename);
        }

        function showGridLoading(show) {
            document.getElementById('grid-loading').classList.toggle('show', show);
        }

        function buildDetailHtml(reportDate) {
            const item = dailyByDate.get(reportDate);
            if (!item) return '<p class="mb-0">داده‌ای یافت نشد.</p>';

            const truckRows = [
                { label: 'مجموع ورود', stat: item.truckEntrance },
                { label: 'خروج خالی کامیون', stat: item.truckEmptyExit },
                { label: 'خروج پر کامیون', stat: item.truckLoadedExit }
            ];

            let html = '<p class="mb-2"><strong>جزئیات کامیون (ایرانی/ترانزیت) — ' + escapeHtml(reportDate) + '</strong></p>';
            html += '<div class="row g-2">';
            truckRows.forEach(r => {
                const s = r.stat || {};
                html += '<div class="col-md-4"><div class="border rounded-2 p-2 bg-white">'
                    + '<div class="fw-medium mb-1">' + escapeHtml(r.label) + '</div>'
                    + '<div class="fs-12 text-muted">کل: ' + fmt(s.total) + ' | ایرانی: ' + fmt(s.iranian) + ' | ترانزیت: ' + fmt(s.transit) + '</div>'
                    + '</div></div>';
            });
            html += '</div>';
            return html;
        }

        function toggleRow(buttonElement, reportDate) {
            const mainRow = buttonElement.closest('tr');
            if (!mainRow) return;

            let detailRow = mainRow.nextElementSibling;

            if (!detailRow || !detailRow.classList.contains('detail-row')) {
                const td = document.createElement('td');
                td.colSpan = 10;
                td.innerHTML = `<div class="detail-content">${buildDetailHtml(reportDate)}</div>`;

                detailRow = document.createElement('tr');
                detailRow.className = 'detail-row';
                detailRow.style.display = 'none';
                detailRow.appendChild(td);

                mainRow.parentElement.insertBefore(detailRow, mainRow.nextSibling);
            }

            const isExpanded = detailRow.style.display !== 'none';
            detailRow.style.display = isExpanded ? 'none' : 'table-row';
            buttonElement.textContent = isExpanded ? '+' : '−';
            buttonElement.classList.toggle('expanded', !isExpanded);
        }

        function badgeFmt(cell) {
            return gridjs.html(`<span class="badge rounded-pill bg-dark-transparent fs-12">${fmt(cell)}</span>`);
        }

        function initGrid() {
            if (typeof gridjs === 'undefined') return;
            const container = document.getElementById('grid-report');
            if (!container) return;
            container.innerHTML = '';

            gridInstance = new gridjs.Grid({
                columns: [
                    {
                        id: 'expand',
                        name: '',
                        width: '50px',
                        sort: false,
                        formatter: (cell, row) => {
                            const reportDate = String(row.cells[2].data).replace(/'/g, "\\'");
                            return gridjs.html(`<button class="expand-btn" onclick="toggleRow(this, '${reportDate}')">+</button>`);
                        }
                    },
                    { id: 'rowNumber', name: 'ردیف', width: '60px', sort: false },
                    { id: 'date', name: 'تاریخ گزارش', width: '110px' },
                    { id: 'truckEntrance', name: 'مجموع ورود', width: '130px', formatter: badgeFmt },
                    { id: 'truckEmptyExit', name: 'خروج خالی کامیون', width: '140px', formatter: badgeFmt },
                    { id: 'truckLoadedExit', name: 'خروج پر کامیون', width: '130px', formatter: badgeFmt },
                    { id: 'carEntrance', name: 'ورود سواری', width: '120px', formatter: badgeFmt },
                    { id: 'carExit', name: 'خروج سواری', width: '120px', formatter: badgeFmt },
                    { id: 'pedestrianEntrance', name: 'ورود نفرو', width: '120px', formatter: badgeFmt },
                    { id: 'pedestrianExit', name: 'خروج نفرو', width: '120px', formatter: badgeFmt }
                ],
                data: gridData,
                language: {
                    search: { placeholder: 'جستجو...' },
                    pagination: { previous: 'قبلی', next: 'بعدی', showing: 'نمایش', of: 'از', results: 'نتیجه', to: 'تا' },
                    loading: 'در حال بارگذاری...',
                    noRecordsFound: 'داده‌ای وجود ندارد',
                    error: 'خطا در بارگذاری داده‌ها'
                },
                pagination: { enabled: true, limit: 25, summary: true },
                search: true,
                sort: true,
                className: { table: 'table table-bordered table-hover', th: 'table-light' }
            });
            gridInstance.render(container);
        }

        function updateGrid(dailyList) {
            document.querySelectorAll('.detail-row').forEach(row => row.remove());

            rawDaily = dailyList || [];
            dailyByDate = new Map();

            gridData = rawDaily.map((item, i) => {
                dailyByDate.set(item.reportDate, item);
                return [
                    i + 1,
                    i + 1,
                    item.reportDate || '',
                    catTotal(item.truckEntrance),
                    catTotal(item.truckEmptyExit),
                    catTotal(item.truckLoadedExit),
                    catTotal(item.carEntrance),
                    catTotal(item.carExit),
                    catTotal(item.pedestrianEntrance),
                    catTotal(item.pedestrianExit)
                ];
            });

            if (gridInstance) {
                gridInstance.updateConfig({ data: gridData }).forceRender();
            } else {
                initGrid();
            }
            $("#customExportButtons").toggleClass("d-none", gridData.length === 0);
        }

        function updateSummaryCards(totalPeriod) {
            totalPeriodData = totalPeriod || null;

            if (!totalPeriodData) {
                $("#summaryCards").addClass("d-none");
                return;
            }

            categoryDefs.forEach(def => {
                $("#sum_" + def.key).text(fmt(catTotal(totalPeriodData[def.key])));
                if (def.hasTransit) {
                    $("#sum_" + def.key + "_transit").text('ترانزیت: ' + fmt(catTransit(totalPeriodData[def.key])));
                }
            });
            $("#summaryCards").removeClass("d-none");
        }

        $(document).ready(function () {
            const today = getPersianDate();
            $("input[name='StartDate']").val(today);
            $("input[name='EndDate']").val(today);

            if (typeof $.fn.persianDatepicker !== "undefined") {
                $(".fc-datepicker").persianDatepicker({
                    format: "YYYY/MM/DD",
                    autoClose: true,
                    initialValue: false
                });
            }

            $("#startDateIcon").on("click", function () {
                $("input[name='StartDate']").focus();
                if ($("input[name='StartDate']").data('persianDatepicker')) $("input[name='StartDate']").data('persianDatepicker').show();
            });
            $("#endDateIcon").on("click", function () {
                $("input[name='EndDate']").focus();
                if ($("input[name='EndDate']").data('persianDatepicker')) $("input[name='EndDate']").data('persianDatepicker').show();
            });

            const now = new Date();
            $("input[name='StartTime']").val("07:00");
            $("input[name='EndTime']").val(String(now.getHours()).padStart(2, '0') + ":" + String(now.getMinutes()).padStart(2, '0'));

            initGrid();
        });

        $("#btnSearch").on("click", function () {
            $("#errorBox").addClass("d-none").removeClass("alert-warning").addClass("alert-danger").html("");

            showGridLoading(true);
            $.ajax({
                url: '/AccessControlReports/Report/GetSumReportAjax',
                type: 'POST',
                data: {
                    StartDate: padDate($("input[name='StartDate']").val()),
                    EndDate: padDate($("input[name='EndDate']").val()),
                    StartTime: $("input[name='StartTime']").val(),
                    EndTime: $("input[name='EndTime']").val()
                },
                success: function (res) {
                    const result = (res && res.data) || {};
                    const daily = result.daily || [];

                    updateSummaryCards(result.totalPeriod);

                    if (!daily.length) {
                        updateGrid([]);
                        $("#errorBox").removeClass("d-none").removeClass("alert-danger").addClass("alert-warning").text("داده‌ای یافت نشد");
                        return;
                    }
                    updateGrid(daily);
                },
                error: function (xhr) {
                    let message = "خطا در ارتباط با سرور";
                    if (xhr.responseJSON && xhr.responseJSON.message) message = xhr.responseJSON.message;
                    $("#errorBox").removeClass("d-none").text(message);
                    updateGrid([]);
                    updateSummaryCards(null);
                },
                complete: function () {
                    showGridLoading(false);
                }
            });
        });

        $("#btnPrint").on("click", function () {
            if (!gridData.length) return;
            renderPrintArea(getReportMeta(), reportHeaders, getReportRows());
            window.print();
        });

        $("#btnExcel").on("click", function () {
            if (!gridData.length) return;
            exportToExcel('گزارش_تجمیعی_تردد.xlsx', getReportMeta(), reportHeaders, getReportRows());
        });
    </script>
}