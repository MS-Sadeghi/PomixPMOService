    <div class="scrollToTop">
        <span class="arrow lh-1">
            <i class="ti ti-caret-up fs-20"></i>
        </span>
    </div>
    <div id="responsive-overlay"></div>
    <!-- ========== SCRIPTS ========== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/%40popperjs/core/umd/popper.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/defaultmenu.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/js/sticky.js"></script>
    <script src="~/assets/libs/%40simonwep/pickr/pickr.es5.min.js"></script>
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    <script src="~/assets/libs/prismjs/prism.js"></script>
    <script src="~/assets/js/prism-custom.js"></script>
    <script src="~/assets/js/custom.js"></script>
    <script src="~/assets/js/date&time_pickers.js"></script>
    <script src="~/assets/libs/gridjs/gridjs.umd.js"></script>
    <!-- SheetJS (Excel export) -->
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <link href="~/assets/libs/persian-datepicker/css/persian-datepicker.min.css" rel="stylesheet" />
    <script src="~/assets/libs/persian-datepicker/index.global.min.js"></script>
    <script src="~/assets/libs/persian-datepicker/persian-date.min.js"></script>
    <script src="~/assets/libs/persian-datepicker/persian-datepicker.min.js"></script>
    <script src="~/assets/libs/fullcalendar/index.global.min.js"></script>
    <!-- Toastify JS -->
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />
    <script src="~/assets/libs/toastify-js/src/toastify.js">
    </script>
    <!-- Toast JS -->
    <script src="~/assets/js/toasts.js">
    </script>
    <script>
         // بروزرسانی سال شمسی
        document.getElementById("year").textContent = new Date().toLocaleDateString("fa-IR", { year: "numeric" });

        function openFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        (function () {
            var homeTitleEl = document.querySelector('.page-header-breadcrumb .breadcrumb-item.active');
            var homeTab = {
                id: 'home',
                title: (homeTitleEl && homeTitleEl.textContent.trim()) || document.title,
                icon: 'ri-home-4-line',
                closable: false
            };

            var tabs = [homeTab];
            var activeId = homeTab.id;
            var seq = 0;

            function $strip() {
                return $('#reportTabsStrip');
            }

            function $framesHost() {
                return $('#reportFramesHost');
            }

            function tabItemHtml(tab) {
                var activeClass = tab.id === activeId ? ' active' : '';
                var closeBtn = tab.closable
                    ? '<span class="report-tab-close" data-id="' + tab.id + '"><i class="ri-close-line"></i></span>'
                    : '';
                return '<a class="report-tab-item' + activeClass + '" data-id="' + tab.id + '" href="javascript:void(0);">' +
                    '<i class="' + tab.icon + ' report-tab-icon"></i><span>' + tab.title + '</span>' + closeBtn +
                    '</a>';
            }

            function renderTabs() {
                var $s = $strip();
                if (!$s.length) return;
                $s.html(tabs.map(tabItemHtml).join(''));
            }

            function activateTab(id) {
                activeId = id;
                $('#reportPaneHome').toggleClass('active', id === 'home');
                $framesHost().children('.report-frame-pane').each(function () {
                    $(this).toggleClass('active', $(this).data('id') === id);
                });
                renderTabs();
            }

            function openReportTab(url, title, icon) {
                seq++;
                var id = 'tab-' + Date.now() + '-' + seq;

                var sameTitleCount = tabs.filter(function (t) { return t.title === title; }).length;
                var displayTitle = sameTitleCount > 0 ? title + ' (' + (sameTitleCount + 1) + ')' : title;

                tabs.push({ id: id, title: displayTitle, icon: icon || 'ri-file-list-3-line', closable: true });

                var sep = url.indexOf('?') === -1 ? '?' : '&';
                var frameUrl = url + sep + 'embed=1';
                var $pane = $('<div class="report-frame-pane" data-id="' + id + '"></div>');
                var $iframe = $('<iframe src="' + frameUrl + '"></iframe>');
                $iframe.on('load', syncIframeThemes);
                $pane.append($iframe);
                $framesHost().append($pane);

                activateTab(id);
            }

            function syncIframeThemes() {
                var html = document.querySelector('html');
                var theme = html.getAttribute('data-theme-mode');
                var headerStyle = html.getAttribute('data-header-styles');
                var menuStyle = html.getAttribute('data-menu-styles');

                document.querySelectorAll('#reportFramesHost iframe').forEach(function (frame) {
                    try {
                        var doc = frame.contentDocument;
                        if (!doc || !doc.documentElement) return;
                        doc.documentElement.setAttribute('data-theme-mode', theme);
                        doc.documentElement.setAttribute('data-header-styles', headerStyle);
                        doc.documentElement.setAttribute('data-menu-styles', menuStyle);
                    } catch (e) {
                        // iframe هنوز لود نشده یا در دسترس نیست؛ نادیده گرفته می‌شود
                    }
                });
            }

            function closeTab(id) {
                var idx = -1;
                for (var i = 0; i < tabs.length; i++) {
                    if (tabs[i].id === id) { idx = i; break; }
                }
                if (idx === -1) return;

                var wasActive = activeId === id;
                tabs.splice(idx, 1);
                $framesHost().children('[data-id="' + id + '"]').remove();

                if (wasActive) {
                    var fallback = tabs[tabs.length - 1] || homeTab;
                    activateTab(fallback.id);
                } else {
                    renderTabs();
                }
            }

            $(document).ready(function () {
                renderTabs();

                $('.js-report-tab-link').on('click', function (e) {
                    e.preventDefault();
                    var url = $(this).attr('href');
                    var title = $(this).data('tab-title') || $(this).find('.side-menu__label').text().trim();
                    var icon = $(this).data('tab-icon');
                    openReportTab(url, title, icon);
                });

                $(document).on('click', '.report-tab-item', function (e) {
                    if ($(e.target).closest('.report-tab-close').length) return;
                    activateTab($(this).data('id'));
                });

                $(document).on('click', '.report-tab-close', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeTab($(this).data('id'));
                });

                // custom.js از قبل روی همین دکمه کلیک را می‌گیرد و تم را روی <html>
                // صفحه‌ی اصلی عوض می‌کند؛ این هندلر بعد از آن اجرا می‌شود تا همان
                // مقدار تازه را روی تمام تب‌های iframe بازِ گزارش‌ها هم اعمال کند.
                $('.layout-setting').on('click', syncIframeThemes);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>