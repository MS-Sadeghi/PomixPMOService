@using IdentityManagementSystem.UI.Areas.Security.Models
@model LoginViewModel
@using DNTCaptcha.Core

@{
    ViewData["Title"] = "ورود به سامانه";
    Layout = "~/Areas/Security/Views/Shared/_LayoutAuth.cshtml";
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .login-card {
        display: flex;
        width: 1000px;
        max-width: 100%;
        background: rgba(255,255,255,.25);
        backdrop-filter: blur(12px);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(31,38,135,.18);
        border: 1px solid rgba(255,255,255,.3);
        transition: .3s;
        position: relative;
    }

        .login-card:hover {
            transform: translateY(-6px);
        }

    /* فرم ورود */
    .login-right {
        flex: 1;
        padding: 45px;
    }

    /* بخش لوگو */
    .login-left {
        width: 360px;
        background: linear-gradient(135deg,#f8fbff,#edf4ff);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-left: 1px solid rgba(0,0,0,.08);
        position: relative;
    }

        .login-left img {
            max-width: 220px;
            width: 100%;
            height: auto;
            margin-bottom: 30px;
            transition: .3s;
        }

            .login-left img:hover {
                transform: scale(1.05);
            }

    .login-title {
        font-size: 26px;
        font-weight: 700;
        color: #244b8b;
        text-align: center;
        margin-bottom: 10px;
    }

    .login-subtitle {
        font-size: 16px;
        color: #666;
        text-align: center;
        line-height: 30px;
    }

    h3 {
        font-weight: 700;
        margin-bottom: 30px;
    }

    .btn-primary {
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
    }

    .captchaInput {
        height: 45px !important;
        border-radius: 8px !important;
        border: 1px solid #ccc !important;
        width: 100% !important;
        text-align: right !important;
    }

    .form-control {
        height: 45px;
        border-radius: 8px;
    }

    .input-group-text {
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    .form-control:focus {
        box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
    }

    /* استایل دکمه پشتیبانی */
    .support-btn {
        position: center;
        background: #0d6efd;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
        transition: all 0.3s ease;
        cursor: pointer;
        z-index: 5;
    }

        .support-btn:hover {
            background: #0b5ed7;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.4);
            color: white;
        }

        .support-btn i {
            font-size: 18px;
        }

    /* استایل مدال */
    .support-modal .modal-header {
        border-bottom: none;
        padding: 20px 25px;
    }

        .support-modal .modal-header .btn-close {
            color: white;
            opacity: 0.8;
        }

            .support-modal .modal-header .btn-close:hover {
                opacity: 1;
            }

    .support-modal .modal-title {
        font-weight: 600;
        font-size: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .support-modal .modal-title i {
            font-size: 24px;
        }

    .support-modal .modal-body {
        padding: 30px 25px;
        min-height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 16px;
    }

        .support-modal .modal-body .empty-state {
            text-align: center;
        }

            .support-modal .modal-body .empty-state i {
                font-size: 48px;
                color: #dee2e6;
                margin-bottom: 15px;
                display: block;
            }

    .support-numbers {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
        max-width: 400px;
    }

    .support-number-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 18px;
        background: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
        transition: all 0.2s;
    }

        .support-number-item:hover {
            background: #e9ecef;
            border-color: #dee2e6;
        }

        .support-number-item i {
            font-size: 20px;
            color: #0d6efd;
            width: 30px;
            text-align: center;
        }

        .support-number-item .number {
            font-weight: 600;
            color: #212529;
            direction: ltr;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .support-number-item .label {
            color: #6c757d;
            font-size: 13px;
        }

    @@media (max-width: 991px) {
        .login-card {
            flex-direction: column;
            width: 100%;
            max-width: 480px;
            margin: 10px;
        }

        .login-left {
            order: 1; /* بالا */
        }

        .login-right {
            order: 2; /* پایین */
        }

        .login-left {
            width: 100%;
            padding: 25px 20px;
            border-bottom: 1px solid rgba(0,0,0,.08);
        }

        .login-right {
            padding: 25px 20px;
        }

        .support-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
        }
    }

    @@media (max-width: 576px) {
        .login-container {
            padding: 10px;
        }

        .login-card {
            border-radius: 16px;
        }

        .login-right {
            padding: 20px 15px;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .btn-primary {
            padding: 14px;
        }

        .support-btn {
            padding: 10px 16px;
            font-size: 13px;
        }

            .support-btn span {
                display: none;
            }

            .support-btn i {
                font-size: 20px;
            }
    }
</style>

<div class="login-container">

    <div class="login-card">

        <!-- سمت راست -->
        <div class="login-right">

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form id="loginForm" method="post" autocomplete="off"
                  asp-area="Security"
                  asp-controller="Account"
                  asp-action="Login">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary-errors d-none">
                </div>

                <!-- Username -->
                <div class="form-group mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="ti ti-user text-muted"></i>
                        </span>

                        <input asp-for="Username"
                               class="form-control"
                               placeholder="نام کاربری"
                               autocomplete="username"
                               required />
                    </div>

                    <span asp-validation-for="Username"
                          class="text-danger d-block mt-1"></span>
                </div>

                <!-- Password -->
                <div class="form-group mb-3">
                    <div class="input-group" id="Password-toggle">

                        <span class="input-group-text bg-white text-muted">
                            <i class="ti ti-lock text-muted"></i>
                        </span>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="رمز عبور"
                               autocomplete="current-password"
                               required />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger d-block mt-1"></span>

                    <a class="float-end link-danger fw-medium fs-12"
                       asp-area="Security"
                       asp-controller="Account"
                       asp-action="ForgotPassword">
                        رمز عبور را فراموش کرده‌اید؟
                    </a>
                </div>

                <!-- Captcha -->
                <div id="securitySection"
                     class="form-group text-start mt-2"
                     style="direction: rtl;">

                    <dnt-captcha asp-captcha-generator-max="9999"
                                 asp-captcha-generator-min="1000"
                                 asp-captcha-generator-language="English"
                                 asp-captcha-generator-display-mode="ShowDigits"
                                 asp-use-relative-urls="true"
                                 asp-placeholder="کد امنیتی را وارد کنید"
                                 asp-validation-error-message="کد امنیتی اشتباه است. لطفاً کد جدید را وارد کنید."
                                 asp-too-many-requests-error-message="درخواست‌های زیاد! لطفاً یک دقیقه صبر کنید!"
                                 asp-font-name="Tahoma"
                                 asp-font-size="30"
                                 asp-fore-color="#333333"
                                 asp-back-color="#FCF6F5FF"
                                 asp-text-box-class="form-control captchaInput"
                                 asp-text-box-template="<div class='form-group'>{0}</div>"
                                 asp-validation-message-class="text-danger captcha-validation-message"
                                 asp-show-refresh-button="true"
                                 asp-refresh-button-class="ti ti-refresh btn captcha-refresh" />
                </div>
                <div class="mt-3">
                    <div class="form-check mb-0">
                        <input class="form-check-input" id="defaultCheck1" type="checkbox" value="">
                        <label class="form-check-label fw-normal fs-13" for="defaultCheck1">
                            رمز عبور را به خاطر بسپار
                        </label>
                    </div>
                </div>
                <!-- Login Button -->
                <div class="form-group mt-3">
                    <button type="submit"
                            id="loginBtn"
                            class="btn btn-primary w-100">

                        <span id="loginText">ورود</span>

                        <span id="loginSpinner"
                              class="spinner-border spinner-border-sm ms-2 d-none"
                              role="status">
                        </span>
                    </button>
                </div>

            </form>

            <div class="text-center my-4 authentication-barrier">
                <p class="text-muted fs-14 mb-0">
                    <i class="ti ti-shield-check me-1 align-middle"></i>
                    این سامانه از قوانین ISMS پیروی می‌کند و تمامی فعالیت‌های شما ثبت (لاگ) می‌شود.
                </p>
            </div>

        </div>

        <!-- سمت چپ -->
        <div class="login-left">
            <img src="~/assets/images/brand-logos/logo-pmo.png" alt="Logo" />
            <div class="login-title">
                اداره کل بنادر و دریانوردی استان هرمزگان
            </div>

            <!-- دکمه تماس با پشتیبانی -->
            <button class="support-btn mt-2" data-bs-toggle="modal" data-bs-target="#supportModal">
                <i class="ti ti-headset"></i>
                <span>پشتیبانی</span>
            </button>
        </div>

    </div>

</div>

<!-- مدال پشتیبانی -->
<div class="modal fade support-modal" id="supportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-headset"></i>
                    شماره‌های پشتیبانی
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <!-- بخش شماره‌های پشتیبانی -->
                <div class="support-numbers">
                    <div class="support-number-item">
                        <i class="ti ti-phone"></i>
                        <div>
                            <div class="label">اداره فاوا واحد نرم‌افزار(ساعت اداری)</div>
                            <div class="number">09940657753 خانم فاطمه صادقی</div>
                        </div>
                    </div>
                    <div class="support-number-item">
                        <i class="ti ti-phone"></i>
                        <div>
                            <div class="label">اداره فاوا واحد نرم‌افزار(ساعت اداری)</div>
                            <div class="number">داخلی 4547</div>
                        </div>
                    </div>
                    <div class="support-number-item">
                        <i class="ti ti-mail"></i>
                        <div>
                            <div class="label">ایمیل پشتیبانی</div>
                            <div class="number">sdi10fateme@gmail.com</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#loginForm').submit(function (e) {

            e.preventDefault();

            const btn = $("#loginBtn");
            const spinner = $("#loginSpinner");
            const text = $("#loginText");

            btn.prop("disabled", true);

            spinner.removeClass("d-none");

            text.text("در حال ورود...");

            $.ajax({

                url: '/Security/Account/Login',

                type: 'POST',

                data: $(this).serialize(),

                success: function (res) {

                    if (res.success) {

                        text.text("ورود موفق");

                        window.location.href = res.redirectUrl;
                    }
                    else {

                        spinner.addClass("d-none");

                        text.text("ورود");

                        btn.prop("disabled", false);

                        toastr.error(res.message);
                    }
                },

                error: function (xhr) {

                    spinner.addClass("d-none");

                    text.text("ورود");

                    btn.prop("disabled", false);

                    toastr.error("خطای سرور");
                }

            });

        });
        @if (TempData["SuccessLogoutMessage"] != null)
        {
                    @:toastr.options = {
                    @:"closeButton": true,
                    @:"progressBar": true,
                    @:"positionClass": "toast-top-left",
                    @:"timeOut": "3000",
                    @:"rtl": true
                    @:};
                    @:toastr.success('@TempData["SuccessLogoutMessage"]');
        }

                const jwtToken = '@ViewBag.JwtToken';
        if (jwtToken) {
            localStorage.setItem('jwtToken', jwtToken);
            window.location.href = '/JudiciaryInquiry/Cartable/Index';
        }

        document.addEventListener('DOMContentLoaded', function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-left",
                "timeOut": "5000",
                "rtl": true
            };

            const shownMessages = new Set();

            document.querySelectorAll(
                '.field-validation-error, .validation-summary-errors'
            ).forEach(function (element) {
                const message = element.textContent.trim();

                if (message && !shownMessages.has(message)) {
                    shownMessages.add(message);
                    toastr.error(message);
                }
            });

            if ('@(!string.IsNullOrEmpty(ViewBag.ErrorMessage) ? ViewBag.ErrorMessage : "")' !== '') {
                toastr.error('@(!string.IsNullOrEmpty(ViewBag.ErrorMessage) ? ViewBag.ErrorMessage : "")');
            }

            const toggle = document.getElementById('Password-toggle');
            const icon = toggle.querySelector('i');
            const input = toggle.querySelector('input');

            toggle.addEventListener('click', function (e) {
                if (e.target.closest('span.input-group-text')) {
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('zmdi-eye');
                        icon.classList.add('zmdi-eye-off');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('zmdi-eye-off');
                        icon.classList.add('zmdi-eye');
                    }
                }
            });
        });

    </script>
}