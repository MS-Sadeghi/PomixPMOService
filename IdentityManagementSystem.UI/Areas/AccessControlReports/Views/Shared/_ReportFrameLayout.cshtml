<!DOCTYPE html>
<html dir="rtl" data-header-styles="light" data-menu-styles="dark" data-nav-layout="vertical" data-theme-mode="light" data-toggled="close" data-width="fullwidth" lang="fa">
<head>
    <!-- Meta Data -->
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <title>@ViewData["Title"] - سامانه تردد</title>
    <!-- Favicon -->
    <link href="~/assets/images/brand-logos/favicon.ico" rel="icon" type="image/x-icon" />
    <!-- Start::Styles -->
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="~/assets/js/main.js"></script>
    <link href="~/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/assets/css/vazir-font.css" rel="stylesheet" />
    <link href="~/assets/css/styles.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/assets/libs/node-waves/waves.min.css" rel="stylesheet" />
    <link href="~/assets/libs/simplebar/simplebar.min.css" rel="stylesheet" />
    <link href="~/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/assets/libs/%40simonwep/pickr/themes/nano.min.css" rel="stylesheet" />
    <link href="~/assets/libs/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" />
    <link href="~/assets/libs/%40tarekraafat/autocomplete.js/css/autoComplete.css" rel="stylesheet" />
    <style>
        body {
            padding: .75rem 1rem;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="loader"></div>
    <div class="container-fluid p-0">
        <div class="row">
            @RenderBody()
        </div>
    </div>
    <!-- ========== SCRIPTS ========== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/%40popperjs/core/umd/popper.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/%40simonwep/pickr/pickr.es5.min.js"></script>
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    <script src="~/assets/libs/prismjs/prism.js"></script>
    <script src="~/assets/js/prism-custom.js"></script>
    <script src="~/assets/js/custom.js"></script>
    <script src="~/assets/js/date&time_pickers.js"></script>
    <script src="~/assets/libs/gridjs/gridjs.umd.js"></script>
    <!-- SheetJS (Excel export) -->
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <link href="~/assets/libs/persian-datepicker/css/persian-datepicker.min.css" rel="stylesheet" />
    <script src="~/assets/libs/persian-datepicker/index.global.min.js"></script>
    <script src="~/assets/libs/persian-datepicker/persian-date.min.js"></script>
    <script src="~/assets/libs/persian-datepicker/persian-datepicker.min.js"></script>
    <script src="~/assets/libs/fullcalendar/index.global.min.js"></script>
    <!-- Toastify JS -->
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />
    <script src="~/assets/libs/toastify-js/src/toastify.js">
    </script>
    <!-- Toast JS -->
    <script src="~/assets/js/toasts.js">
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>