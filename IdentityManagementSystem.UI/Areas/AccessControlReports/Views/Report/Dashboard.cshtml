@{
    ViewData["Title"] = "داشبورد";
}

<style>
    .dashboard-filter-item.active {
        background-color: var(--bs-primary);
        color: #fff;
    }

        .dashboard-filter-item.active::after {
            content: "\2713";
            float: left;
        }

    #periodIndicator {
        font-size: 12px;
        color: #6c757d;
    }

    #weeklyTrafficChart {
        min-height: 320px;
    }

    #trafficTypesChart {
        min-height: 280px;
    }

    .chart-card-body {
        position: relative;
    }

    .chart-loading-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        background: rgba(255, 255, 255, .75);
        z-index: 5;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .15s ease;
    }

        .chart-loading-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .chart-loading-overlay .spinner-border {
            width: 2rem;
            height: 2rem;
        }

        .chart-loading-overlay .loading-text {
            font-size: 13px;
            color: #6c757d;
        }

    .stat-value.is-loading {
        color: transparent !important;
        position: relative;
        display: inline-block;
        min-width: 48px;
        border-radius: 4px;
        overflow: hidden;
    }

        .stat-value.is-loading::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, #e9ecef 25%, #f1f3f5 37%, #e9ecef 63%);
            background-size: 400% 100%;
            animation: dashboard-skeleton 1.4s ease infinite;
        }

    @@keyframes dashboard-skeleton {
        0% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0 50%;
        }
    }

    #refreshDashboardBtn.is-loading i {
        animation: dashboard-spin .8s linear infinite;
    }

    @@keyframes dashboard-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .dashboard-filter-item.disabled {
        pointer-events: none;
        opacity: .6;
    }

    @@media print {
        .page-header-breadcrumb .dropdown,
        #refreshDashboardBtn,
        #printDashboardBtn,
        #btnExportWeekly {
            display: none !important;
        }
    }
</style>

<!-- Start::page-header -->
<div class="col-xl-12">
    <div class="d-flex align-items-center justify-content-between my-3 page-header-breadcrumb flex-wrap gap-2">
        <div>
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="javascript:void(0);">داشبورد</a></li>
                    <li aria-current="page" class="breadcrumb-item active">داشبورد آماری</li>
                </ol>
            </nav>
            <div id="periodIndicator">نمایش آمار برای: <span id="periodIndicatorText">امروز</span></div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="dropdown">
                <button aria-expanded="false" class="btn btn-primary btn-wave" data-bs-auto-close="outside" data-bs-toggle="dropdown" id="dashboardFilterDropdown" type="button">
                    فیلتر: امروز
                    <i class="ri-arrow-down-s-fill ms-1"></i>
                </button>
                <ul aria-labelledby="dashboardFilterDropdown" class="dropdown-menu" id="dashboardFilterMenu">
                    <li><a class="dropdown-item dashboard-filter-item active" href="javascript:void(0);" data-period="today">امروز</a></li>
                    <li><a class="dropdown-item dashboard-filter-item" href="javascript:void(0);" data-period="yesterday">دیروز</a></li>
                    <li><a class="dropdown-item dashboard-filter-item" href="javascript:void(0);" data-period="last7">۷ روز گذشته</a></li>
                    <li><a class="dropdown-item dashboard-filter-item" href="javascript:void(0);" data-period="last30">۳۰ روز گذشته</a></li>
                </ul>
            </div>
            <button class="btn btn-secondary btn-icon btn-wave" data-bs-placement="top" data-bs-title="بروزرسانی" data-bs-toggle="tooltip" id="refreshDashboardBtn">
                <i class="ti ti-refresh"></i>
            </button>
            <button class="btn btn-light border btn-icon btn-wave" data-bs-placement="top" data-bs-title="چاپ" data-bs-toggle="tooltip" id="printDashboardBtn">
                <i class="ti ti-printer"></i>
            </button>
        </div>
    </div>
</div>
<!-- End::page-header -->
<!-- Start::welcome banner -->
<div class="col-xl-12">
    <div class="card custom-card main-banner-card overflow-hidden">
        <div class="card-body p-4">
            <div class="row align-items-center">
