@using IdentityManagementSystem.UI.Areas.AccessControlReports.ViewModel
@model GetDataReportPageViewModel
@{
    ViewData["Title"] = "گزارش تردد مسیر";
}
<link rel="stylesheet" href="~/css/IndexStyle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/assets/libs/gridjs/theme/mermaid.min.css" />
<style>
    #entranceTypeMenu {
        max-height: 220px;
        overflow-y: auto;
    }

    #entranceTypeBtn.is-invalid {
        border-color: #dc3545;
    }

    #entranceTypeBtn {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        #entranceTypeBtn .dropdown-toggle-text {
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    #customExportButtons {
        margin-bottom: 1rem;
    }

    .gridjs-table {
        table-layout: fixed;
        width: 100%;
    }

        .gridjs-table th, .gridjs-table td {
            text-align: center !important;
            vertical-align: middle !important;
        }

            .gridjs-table th:first-child, .gridjs-table td:first-child {
                width: 80px;
            }

            .gridjs-table th:nth-child(2), .gridjs-table td:nth-child(2) {
                width: 60px;
            }

            .gridjs-table th:nth-child(3), .gridjs-table td:nth-child(3) {
                width: 150px;
            }

            .gridjs-table th:nth-child(4), .gridjs-table td:nth-child(4) {
                width: auto;
            }

            .gridjs-table th:last-child, .gridjs-table td:last-child {
                width: 100px;
            }

    .gridjs-pagination {
        justify-content: flex-start !important;
    }

        .gridjs-pagination .gridjs-summary {
            margin-right: 0;
            margin-left: auto;
        }

    .expand-btn {
        background: none;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        color: #495057;
        padding: 0;
        margin: 0 auto;
    }

        .expand-btn:hover {
            background: #e9ecef;
            border-color: #adb5bd;
        }

        .expand-btn.expanded {
            background: #0d6efd;
            border-color: #0d6efd;
            color: white;
        }

    .detail-row td {
        padding: 0 !important;
        background-color: #f8f9fa;
    }

    .detail-content {
        padding: 15px 20px;
        text-align: right;
        border-top: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }

        .detail-content p {
            margin: 0 0 5px 0;
        }

    #grid-loading {
        text-align: center;
        padding: 15px 0;
        display: none;
    }

        #grid-loading.show {
            display: block;
        }

        #grid-loading .spinner-border {
            width: 2.5rem;
            height: 2.5rem;
        }

        #grid-loading .loading-text {
            margin-top: 8px;
            font-size: 15px;
            color: #495057;
        }

    #loadingBox {
        display: none !important;
    }
</style>

<div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">گزارش‌ها</a></li>
                <li aria-current="page" class="breadcrumb-item active">گزارش تردد مسیر</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title">گزارش تردد مسیر</div>
    </div>
    <div class="card-body">
        <form id="reportForm">
            <div class="row">
                <div class="col-md-2 mb-3">
                    <label class="form-label">مسیر تردد</label>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-info dropdown-toggle w-100 text-end" id="entranceTypeBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="انتخاب کنید">
                            <span class="dropdown-toggle-text">انتخاب کنید</span>
                        </button>
                        <ul class="dropdown-menu w-100 p-2" id="entranceTypeMenu" aria-labelledby="entranceTypeBtn" style="max-height:300px;overflow-y:auto;">
                            <li class="px-2 pb-2">
                                <input type="search" class="form-control form-control-sm" id="entranceTypeSearch" placeholder="جستجو..." autocomplete="off">
                            </li>
                            <li>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="entranceTypeAll">
                                    <label class="form-check-label" for="entranceTypeAll">همه</label>
                                </div>
                                <hr class="dropdown-divider" />
                            </li>
                            <li class="dropdown-header-item" data-group="east"><h6 class="dropdown-header">درب شرقی</h6></li>
                            <li class="option-item" data-group="east"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="1" id="entranceType1"><label class="form-check-label" for="entranceType1">درب شرقی مسیر 1</label></div></li>
                            <li class="option-item" data-group="east"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="2" id="entranceType2"><label class="form-check-label" for="entranceType2">درب شرقی مسیر 2</label></div></li>
                            <li class="option-item" data-group="east"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="11" id="entranceType11"><label class="form-check-label" for="entranceType11">درب شرقی مسیر 3</label></div></li>
                            <li class="option-item" data-group="east"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="120" id="entranceType120"><label class="form-check-label" for="entranceType120">درب شرقی مسیر 4</label></div></li>
                            <li class="option-item" data-group="east"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="13" id="entranceType13"><label class="form-check-label" for="entranceType13">درب شرقی مسیر 5</label></div></li>
                            <li class="option-item" data-group="east"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="140" id="entranceType140"><label class="form-check-label" for="entranceType140">درب شرقی مسیر 6</label></div></li>
                            <hr class="dropdown-divider" />
                            <li class="dropdown-header-item" data-group="west"><h6 class="dropdown-header">درب غربی</h6></li>
                            <li class="option-item" data-group="west"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="4" id="entranceType4"><label class="form-check-label" for="entranceType4">درب غربی مسیر 1</label></div></li>
                            <li class="option-item" data-group="west"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="5" id="entranceType5"><label class="form-check-label" for="entranceType5">درب غربی مسیر 2</label></div></li>
                            <li class="option-item" data-group="west"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="3" id="entranceType3"><label class="form-check-label" for="entranceType3">درب غربی مسیر 3</label></div></li>
                            <li class="option-item" data-group="west"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="7" id="entranceType7"><label class="form-check-label" for="entranceType7">درب غربی مسیر 4</label></div></li>
                            <hr class="dropdown-divider" />
                            <li class="dropdown-header-item" data-group="bijak"><h6 class="dropdown-header">بیجک</h6></li>
                            <li class="option-item" data-group="bijak"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="19" id="entranceType19"><label class="form-check-label" for="entranceType19">بیجک مسیر 8 درب شرقی</label></div></li>
                            <li class="option-item" data-group="bijak"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="22" id="entranceType22"><label class="form-check-label" for="entranceType22">بیجک مسیر 9 درب شرقی</label></div></li>
                            <li class="option-item" data-group="bijak"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="23" id="entranceType23"><label class="form-check-label" for="entranceType23">بیجک مسیر 10 درب شرقی</label></div></li>
                            <li class="option-item" data-group="bijak"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="12" id="entranceType12"><label class="form-check-label" for="entranceType12">بیجک مسیر 6 درب غربی</label></div></li>
                            <li class="option-item" data-group="bijak"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="14" id="entranceType14"><label class="form-check-label" for="entranceType14">بیجک Xray درب غربی</label></div></li>
                            <hr class="dropdown-divider" />
                            <li class="dropdown-header-item" data-group="other"><h6 class="dropdown-header">سایر</h6></li>
                            <li class="option-item" data-group="other"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="نفر رو ورودی" id="entranceTypePedIn"><label class="form-check-label" for="entranceTypePedIn">نفر رو ورودی</label></div></li>
                            <li class="option-item" data-group="other"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="نفر رو خروجی" id="entranceTypePedOut"><label class="form-check-label" for="entranceTypePedOut">نفر رو خروجی</label></div></li>
                            <li class="option-item" data-group="other"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="سواری رو ورود" id="entranceTypeCarIn"><label class="form-check-label" for="entranceTypeCarIn">سواری رو ورودی</label></div></li>
                            <li class="option-item" data-group="other"><div class="form-check"><input class="form-check-input entrance-type-checkbox" type="checkbox" value="سواری رو خروج" id="entranceTypeCarOut"><label class="form-check-label" for="entranceTypeCarOut">سواری رو خروجی</label></div></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">از تاریخ</label>
                    <div class="input-group">
                        <span class="input-group-text" id="startDateIcon" style="cursor:pointer;"><i class="ti ti-calendar"></i></span>
                        <input name="StartDate" class="form-control fc-datepicker" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">تا تاریخ</label>
                    <div class="input-group">
                        <span class="input-group-text" id="endDateIcon" style="cursor:pointer;"><i class="ti ti-calendar"></i></span>
                        <input name="EndDate" class="form-control fc-datepicker" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">از ساعت</label>
                    <input name="StartTime" type="time" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">تا ساعت</label>
                    <input name="EndTime" type="time" class="form-control" />
                </div>
                <div class="col-md-12 text-end">
                    <button type="button" id="btnSearch" class="btn btn-primary"><i class="ti ti-search"></i> دریافت گزارش</button>
                </div>
            </div>
        </form>
        <hr />
        <div id="errorBox" class="alert alert-danger d-none"></div>
        <div id="customExportButtons" class="btn-group mb-3 d-none">
            <button class="btn btn-info-light" id="btnPrint"><i class="ti ti-printer"></i> پرینت</button>
            <button class="btn btn-info-light" id="btnExcel"><i class="ti ti-file-spreadsheet"></i> اکسل</button>
        </div>

        <div id="grid-loading">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div>
            <div class="loading-text">در حال دریافت اطلاعات ...</div>
        </div>
        <div id="grid-report"></div>
    </div>
</div>

@section Scripts
{
    <script>
        let gridInstance = null;
        let gridData = [];

        function padDate(d) {
            if (!d) return d;
            let p = d.split('/');
            return p[0] + '/' + p[1].padStart(2, '0') + '/' + p[2].padStart(2, '0');
        }

        function getSelectedEntranceTypes() {
            return $(".entrance-type-checkbox:checked").map(function () { return $(this).val(); }).get();
        }

        function updateEntranceTypeButtonText() {
            const checked = $(".entrance-type-checkbox:checked");
            const $btn = $("#entranceTypeBtn");
            const $label = $btn.find(".dropdown-toggle-text");
            let text;
            if (checked.length === 0) text = "انتخاب کنید";
            else if (checked.length === $(".entrance-type-checkbox").length) text = "همه";
            else {
                text = checked.map(function () { return $("label[for='" + this.id + "']").text(); }).get().join('، ');
            }
            $label.text(text);
            $btn.attr("title", text);
        }

        function getPersianDate() {
            const formatter = new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: '2-digit', day: '2-digit' });
            return formatter.format(new Date()).replace(/\//g, '/');
        }

        function toggleRow(buttonElement) {
            const mainRow = buttonElement.closest('tr');
            if (!mainRow) return;

            // پیدا کردن سطر جزئیات بعد از سطر اصلی
            let detailRow = mainRow.nextElementSibling;

            // اگر سطر جزئیات وجود ندارد یا سطر بعدی جزئیات نیست، آن را ایجاد کن
            if (!detailRow || !detailRow.classList.contains('detail-row')) {
                const td = document.createElement('td');
                td.colSpan = 5; // تعداد ستون‌ها
                td.innerHTML = `<div class="detail-content">
                    <p><strong>جزئیات</strong></p>
                    <p>اطلاعات تکمیلی اینجا نمایش داده می‌شود.</p>
                </div>`;

                detailRow = document.createElement('tr');
                detailRow.className = 'detail-row';
                detailRow.style.display = 'none';
                detailRow.appendChild(td);

                // درج سطر جزئیات بعد از سطر اصلی
                mainRow.parentElement.insertBefore(detailRow, mainRow.nextSibling);
            }

            // تغییر وضعیت نمایش
            const isExpanded = detailRow.style.display !== 'none';
            detailRow.style.display = isExpanded ? 'none' : 'table-row';
            buttonElement.textContent = isExpanded ? '+' : '−';
            buttonElement.classList.toggle('expanded', !isExpanded);
        }

        function showGridLoading(show) {
            document.getElementById('grid-loading').classList.toggle('show', show);
        }

        function initGrid() {
            if (typeof gridjs === 'undefined') return;
            const container = document.getElementById('grid-report');
            if (!container) return;
            container.innerHTML = '';

            gridInstance = new gridjs.Grid({
                columns: [
                    {
                        id: 'expand',
                        name: '',
                        width: '60px',
                        sort: false,
                        formatter: (cell, row) => {
                            return gridjs.html(`<button class="expand-btn" onclick="toggleRow(this)">+</button>`);
                        }
                    },
                    { id: 'rowNumber', name: 'ردیف', width: '80px', sort: false },
                    { id: 'date', name: 'تاریخ', width: '150px' },
                    { id: 'entranceType', name: 'مسیر تردد', width: 'auto' },
                    {
                        id: 'count',
                        name: 'تعداد',
                        width: '100px',
                        formatter: (cell) => gridjs.html(`<span class="badge rounded-pill bg-dark-transparent fs-12">${cell}</span>`)
                    }
                ],
                data: gridData,
                language: {
                    search: { placeholder: 'جستجو...' },
                    pagination: { previous: 'قبلی', next: 'بعدی', showing: 'نمایش', of: 'از', results: 'نتیجه', to: 'تا' },
                    loading: 'در حال بارگذاری...',
                    noRecordsFound: 'داده‌ای وجود ندارد',
                    error: 'خطا در بارگذاری داده‌ها'
                },
                pagination: { enabled: true, limit: 25, summary: true },
                search: true,
                sort: true,
                resizable: true,
                className: { table: 'table table-bordered table-hover', th: 'table-light' }
            });

            gridInstance.render(container);
        }

        function updateGrid(rows) {
            // حذف سطرهای جزئیات قدیمی
            document.querySelectorAll('.detail-row').forEach(row => row.remove());

            gridData = rows.map((item, i) => [
                i + 1,
                i + 1,
                item.reportDate || '',
                item.entranceType || '',
                item.recordCount || 0
            ]);

            if (gridInstance) {
                gridInstance.updateConfig({ data: gridData }).forceRender();
            } else {
                initGrid();
            }
            $("#customExportButtons").toggleClass("d-none", gridData.length === 0);
        }

        $(document).ready(function () {
            const today = getPersianDate();
            $("input[name='StartDate']").val(today);
            $("input[name='EndDate']").val(today);

            if (typeof $.fn.persianDatepicker !== "undefined") {
                $(".fc-datepicker").persianDatepicker({
                    format: "YYYY/MM/DD",
                    autoClose: true,
                    initialValue: false
                });
            }

            $("#startDateIcon").click(function () {
                $("input[name='StartDate']").focus();
                $("input[name='StartDate']").data("persianDatepicker").show();
            });

            $("#endDateIcon").click(function () {
                $("input[name='EndDate']").focus();
                $("input[name='EndDate']").data("persianDatepicker").show();
            });

            const now = new Date();
            $("input[name='StartTime']").val("07:00");
            $("input[name='EndTime']").val(String(now.getHours()).padStart(2, '0') + ":" + String(now.getMinutes()).padStart(2, '0'));

            $("#entranceTypeMenu").on("click", e => e.stopPropagation());
            $("#entranceTypeAll").on("change", function () {
                $(".entrance-type-checkbox").prop("checked", $(this).is(":checked"));
                updateEntranceTypeButtonText();
                $("#entranceTypeBtn").removeClass("is-invalid");
            });

            $(document).on("change", ".entrance-type-checkbox", function () {
                const total = $(".entrance-type-checkbox").length;
                $("#entranceTypeAll").prop("checked", $(".entrance-type-checkbox:checked").length === total);
                updateEntranceTypeButtonText();
                $("#entranceTypeBtn").removeClass("is-invalid");
            });

            // راه‌اندازی جدول خالی
            initGrid();
        });

        $("#btnSearch").on("click", function () {
            $("#errorBox").addClass("d-none").removeClass("alert-warning").addClass("alert-danger").html("");
            const entranceTypes = getSelectedEntranceTypes();
            if (entranceTypes.length === 0) {
                $("#entranceTypeBtn").addClass("is-invalid");
                $("#errorBox").removeClass("d-none").removeClass("alert-danger").addClass("alert-warning").text("لطفاً حداقل یک نوع تردد را انتخاب کنید.");
                return;
            }

            showGridLoading(true);
            $.ajax({
                url: '/AccessControlReports/Report/GetDataReportAjax',
                type: 'POST',
                data: {
                    StartDate: padDate($("input[name='StartDate']").val()),
                    EndDate: padDate($("input[name='EndDate']").val()),
                    StartTime: $("input[name='StartTime']").val(),
                    EndTime: $("input[name='EndTime']").val(),
                    EntranceTypes: entranceTypes
                },
                traditional: true,
                success: function (res) {
                    let rows = res.data || res || [];
                    if (!rows.length) {
                        updateGrid([]);
                        $("#errorBox").removeClass("d-none").removeClass("alert-danger").addClass("alert-warning").text("داده‌ای یافت نشد");
                        return;
                    }
                    updateGrid(rows);
                },
                error: function (xhr) {
                    let message = "خطا در ارتباط با سرور";
                    if (xhr.responseJSON && xhr.responseJSON.message) message = xhr.responseJSON.message;
                    $("#errorBox").removeClass("d-none").text(message);
                    updateGrid([]);
                },
                complete: function () {
                    showGridLoading(false);
                }
            });
        });

        $("#btnPrint").on("click", () => window.print());

        $("#btnExcel").on("click", function () {
            if (!gridData.length) return;
            let csv = "ردیف,تاریخ,مسیر تردد,تعداد\n";
            gridData.forEach(r => {
                csv += `${r[1]},${r[2]},${r[3]},${r[4]}\n`;
            });
            const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "گزارش_تردد.csv";
            link.click();
        });

        document.getElementById('entranceTypeSearch').addEventListener('input', function () {
          const q = this.value.trim().toLowerCase();
          const menu = document.getElementById('entranceTypeMenu');
          const groups = {};
          menu.querySelectorAll('.option-item').forEach(li => {
            const text = li.querySelector('label').textContent.toLowerCase();
            const match = !q || text.includes(q);
            li.style.display = match ? '' : 'none';
            const g = li.dataset.group;
            if (match) groups[g] = true;
          });
          menu.querySelectorAll('.dropdown-header-item').forEach(h => {
            h.style.display = groups[h.dataset.group] ? '' : 'none';
          });
        });
    </script>
}