<!-- End::traffic types + recent reports -->
@section Scripts {
    <script src="~/assets/js/apexcharts.js"></script>

    <script>
        $(document).ready(function () {
            loadDashboard();

            $('#refreshDashboardBtn').on('click', function () {
                loadDashboard();
            });
        });

        function loadDashboard() {
            $.ajax({
                url: '@Url.Action("GetDashboardAjax", "Report", new { area = "AccessControlReports" })',
                type: 'POST',
                success: function (response) {
                    if (!response.success) {
                        console.error(response.message || 'خطا در دریافت اطلاعات داشبورد');
                        return;
                    }

                    const data = response.data;

                    $('#totalTrafficToday').text(
                        Number(data.totalTrafficToday || 0).toLocaleString('fa-IR')
                    );

                    $('#vehicleTrafficToday').text(
                        Number(data.vehicleTrafficToday || 0).toLocaleString('fa-IR')
                    );

                    $('#peopleTrafficToday').text(
                        Number(data.peopleTrafficToday || 0).toLocaleString('fa-IR')
                    );

                    $('#reportsCountToday').text(
                        Number(data.reportsCountToday || 0).toLocaleString('fa-IR')
                    );

                    $('#lastUpdated').text(data.lastUpdated || '-');

                    renderWeeklyTrafficChart(data.weeklyTraffic || []);
                    renderTrafficTypesChart(data.trafficTypes || []);
                },
                error: function (xhr) {
                    console.error(
                        xhr.responseJSON?.message ||
                        'خطا در دریافت اطلاعات داشبورد'
                    );
                }
            });
        }

        let weeklyChartInstance = null;
        let trafficTypesChartInstance = null;

        function renderWeeklyTrafficChart(items) {
            const chartElement = document.querySelector('#weeklyTrafficChart');
            if (!chartElement) return;

            const options = {
                chart: {
                    type: 'area',
                    height: 320,
                    toolbar: { show: false },
                    fontFamily: 'inherit'
                },
                series: [
                    {
                        name: 'تعداد تردد',
                        data: items.map(x => x.value)
                    }
                ],
                colors: ['#845adf'],
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.35,
                        opacityTo: 0.05,
                        stops: [0, 90, 100]
                    }
                },
                xaxis: {
                    categories: items.map(x => x.label)
                },
                stroke: {
                    curve: 'smooth',
                    width: 3
                },
                dataLabels: { enabled: false },
                grid: { strokeDashArray: 4 },
                noData: { text: 'داده‌ای برای نمایش وجود ندارد' }
            };

            if (weeklyChartInstance) {
                weeklyChartInstance.destroy();
            }
            weeklyChartInstance = new ApexCharts(chartElement, options);
            weeklyChartInstance.render();
        }

        function renderTrafficTypesChart(items) {
            const chartElement = document.querySelector('#trafficTypesChart');
            if (!chartElement) return;

            const options = {
                chart: {
                    type: 'donut',
                    height: 280,
                    fontFamily: 'inherit'
                },
                series: items.map(x => x.value),
                labels: items.map(x => x.label),
                colors: ['#845adf', '#e58a00', '#01a3ae', '#dc3545'],
                legend: {
                    position: 'bottom',
                    fontFamily: 'inherit'
                },
                dataLabels: { enabled: false },
                noData: { text: 'داده‌ای برای نمایش وجود ندارد' }
            };

            if (trafficTypesChartInstance) {
                trafficTypesChartInstance.destroy();
            }
            trafficTypesChartInstance = new ApexCharts(chartElement, options);
            trafficTypesChartInstance.render();
        }
    </script>
}
