@using IdentityManagementSystem.UI.Areas.Security.Models
@model UserInfo
@{
    ViewData["Title"] = "پروفایل";
    Layout = "~/Areas/AccessControlReports/Views/Shared/_AccessControlReportsLayout.cshtml";
}

<div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">مدیریت کاربران</a></li>
                <li aria-current="page" class="breadcrumb-item active">پروفایل</li>
            </ol>
        </nav>
    </div>
</div>

<div class="col-xxl-12">
    <div class="card custom-card profile-card overflow-hidden bg-transparent shadow-none">
        <div class="profile-background">
            <img src="~/assets/images/media/backgrounds/7.png" alt="background">
        </div>
        <div class="main-profile-cover">
            <div class="p-xl-5 pb-xl-0 p-4 position-relative">
                <div class="d-flex gap-3 align-items-center justify-content-center flex-wrap mb-4">
                    <div class="main-avatar">
                        <img alt="پروفایل" class="img-fluid rounded-circle p-1 shadow-sm bg-light"
                             src="~/assets/images/faces/21.jpg">
                    </div>
                    <div class="text-center">
                        <h4 class="fw-semibold mb-1">
                            @(Model?.Name ?? "نام کاربر") @(Model?.LastName ?? "")
                        </h4>
                        <p class="mb-0 fs-15">
                            <i class="ti ti-briefcase lh-1 align-middle me-2"></i>
                            @(Model?.Role ?? "بدون نقش")
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body p-0 position-relative mx-3 main-card-body mt-4">
                <div class="profile-content">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <script>toastr.error('@ViewBag.ErrorMessage');</script>
                    }
                    @if (ViewBag.SuccessMessage != null)
                    {
                        <script>toastr.success('@ViewBag.SuccessMessage');</script>
                    }

                    <form id="changePasswordForm"
                          asp-area="Security"
                          asp-controller="Account"
                          asp-action="ChangePassword"
                          method="post">
                        @Html.AntiForgeryToken()

                        <ul class="list-group list-group-flush border rounded-3">
                            <li class="list-group-item p-3">
                                <div class="row gy-3 align-items-center">
                                    <div class="col-xl-3">
                                        <span class="fw-medium">رمز عبور فعلی:</span>
                                    </div>
                                    <div class="col-xl-9">
                                        <div class="input-group">
                                            <span class="input-group-text toggle-password" style="cursor: pointer;">
                                                <i class="ti ti-eye"></i>
                                            </span>
                                            <input class="form-control" type="password" name="CurrentPassword"
                                                   autocomplete="current-password" placeholder="رمز عبور فعلی">
                                        </div>
                                    </div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">رمز عبور جدید:</span>
                                    </div>
                                    <div class="col-xl-9">
                                        <div class="input-group">
                                            <span class="input-group-text toggle-password" style="cursor: pointer;">
                                                <i class="ti ti-eye"></i>
                                            </span>
                                            <input class="form-control" type="password" name="NewPassword"
                                                   autocomplete="new-password" placeholder="رمز عبور جدید">
                                        </div>
                                    </div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">تایید رمز عبور:</span>
                                    </div>
                                    <div class="col-xl-9">
                                        <div class="input-group">
                                            <span class="input-group-text toggle-password" style="cursor: pointer;">
                                                <i class="ti ti-eye"></i>
                                            </span>
                                            <input class="form-control" type="password" name="ConfirmNewPassword"
                                                   autocomplete="new-password" placeholder="تایید رمز عبور">
                                        </div>
                                    </div>
                                </div>

                                <div class="text-end mt-4">
                                    <button type="submit" class="btn btn-primary">ثبت</button>
                                    <a href="/AccessControlReports/Report/GetDataReport" class="btn btn-danger">انصراف</a>
                                </div>
                            </li>
                        </ul>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#changePasswordForm").submit(function (e) {
                e.preventDefault();
                var form = $(this);
                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            form[0].reset();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (xhr) {
                        toastr.error(xhr.responseJSON?.message ?? xhr.responseText);
                    }
                });
            });
        });
        document.querySelectorAll('.toggle-password').forEach(element => {
                element.addEventListener('click', function() {
                    const input = this.closest('.input-group').querySelector('input');
                    const icon = this.querySelector('i');

                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.className = 'ti ti-eye-off';
                    } else {
                        input.type = 'password';
                        icon.className = 'ti ti-eye';
                    }
                });
        });
    </script>
}