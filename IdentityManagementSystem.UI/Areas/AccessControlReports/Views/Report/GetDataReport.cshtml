@using IdentityManagementSystem.UI.Areas.AccessControlReports.ViewModel
@model GetDataReportPageViewModel

@{
    ViewData["Title"] = "گزارش خلاصه تردد";
}

<link rel="stylesheet" href="~/css/IndexStyle.css" asp-append-version="true" />

<style>
    .dataTables_wrapper .dataTables_filter {
        float: left !important;
    }

    #customExportButtons {
        float: right;
    }
</style>

<div class="card">

<div class="card-header">
    <h5 class="card-title">گزارش خلاصه ترددها</h5>
</div>

<div class="card-body">

    <form id="reportForm">

        <div class="row">

            <div class="col-md-3 mb-3">
                <label>از تاریخ</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa fa-calendar"></i>
                    </span>

                    <input name="StartDate"
                           class="form-control fc-datepicker"
                           autocomplete="off" />
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <label>تا تاریخ</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa fa-calendar"></i>
                    </span>

                    <input name="EndDate"
                           class="form-control fc-datepicker"
                           autocomplete="off" />
                </div>
            </div>

            <div class="col-md-2 mb-3">
                <label>از ساعت</label>
                <input name="StartTime" type="time" class="form-control" />
            </div>

            <div class="col-md-2 mb-3">
                <label>تا ساعت</label>
                <input name="EndTime" type="time" class="form-control" />
            </div>

            <div class="col-md-2 mb-3">
                    <label class="form-label">نوع تردد</label>
                <select name="EntranceTypes"
                        class="form-control form-select"
                             placeholder="انتخاب کنید">
                    <option value="0">--انتخاب کنید--</option>
                    <option value="1">درب شرقی ورود مسیر 1</option>
                    <option value="2">درب شرقی ورود مسیر 2</option>
                    <option value="3">درب شرقی ورود مسیر 3</option>
                    <option value="4">درب غربی خروج</option>
                    <option value="5">درب غربی ورود</option>

                </select>
            </div>

            <div class="col-md-12 text-end">

                <button type="button"
                        id="btnSearch"
                        class="btn btn-primary">

                    <i class="fe fe-search"></i>
                    دریافت گزارش

                </button>

            </div>

        </div>

    </form>

    <hr />

    <div id="errorBox"
         class="alert alert-danger d-none">
    </div>

    <div id="loadingBox"
         class="text-center d-none my-3">

        <div class="spinner-border text-primary"></div>

        <div class="mt-2">
            در حال دریافت اطلاعات ...
        </div>

    </div>

    <div class="table-responsive">

        <table id="reportTable"
               class="table table-bordered table-hover">

            <thead class="table-light">

                <tr>
                    <th>ردیف</th>
                    <th>تاریخ</th>
                    <th>مسیر تردد</th>
                    <th>تعداد</th>
                </tr>

            </thead>

            <tbody>
            </tbody>

        </table>

    </div>

</div>


</div>

@section Scripts
{
    <script>
              let reportTable;

              function fixPersianForPdf(value) {
                  if (value === null || value === undefined) {
                      return "";
                  }

                  const text = $('<div>').html(value).text().trim();

                  if (!/[\u0600-\u06FF]/.test(text)) {
                      return text;
                  }

                  return text.split(/\s+/).reverse().join(' ');
              }

              $(document).ready(function () {

                  if (typeof $.fn.persianDatepicker !== "undefined") {
                      $(".fc-datepicker").persianDatepicker({
                          format: "YYYY/MM/DD",
                          autoClose: true
                      });
                  }

                  const now = new Date();

                  const currentTime =
                      String(now.getHours()).padStart(2, '0') +
                      ":" +
                      String(now.getMinutes()).padStart(2, '0');

                  $("input[name='StartTime']").val("00:00");
                  $("input[name='EndTime']").val(currentTime);

                  window.pdfMake = window.pdfMake || {};

                  pdfMake.fonts = {
                      Vazir: {
                          normal: 'Vazir.ttf',
                          bold: 'Vazir.ttf',
                          italics: 'Vazir.ttf',
                          bolditalics: 'Vazir.ttf'
                      }
                  };

                  reportTable = $("#reportTable").DataTable({
                      destroy: true,
                      pageLength: 25,
                      responsive: true,
                      searching: true,
                      ordering: true,
                      autoWidth: false,

                      language: {
                          url: "/assets/datatables/fa.json"
                      },

                      dom: 'Bfrtip',

                      buttons: [
                          {
                              extend: 'excelHtml5',
                              title: 'گزارش خلاصه تردد',

                              exportOptions: {
                                  columns: [0, 1, 2, 3],

                                  format: {
                                      body: function (data, row, column) {
                                          const text = $('<div>').html(data).text().trim();

                                          // تاریخ به‌صورت متن وارد Excel شود
                                          if (column === 1) {
                                              return "'" + text;
                                          }

                                          return text;
                                      }
                                  }
                              },

                              customize: function (xlsx) {
                                  const sheet = xlsx.xl.worksheets['sheet1.xml'];

                                  $('cols col', sheet).each(function (index) {
                                      let width = 18;

                                      if (index === 0) width = 10;
                                      if (index === 1) width = 18;
                                      if (index === 2) width = 35;
                                      if (index === 3) width = 15;

                                      $(this).attr('width', width);
                                      $(this).attr('customWidth', 1);
                                  });
                              }
                          },
                          {
                              extend: 'pdfHtml5',
                              title: fixPersianForPdf('گزارش خلاصه تردد'),
                              pageSize: 'A4',
                              pageOrientation: 'landscape',

                              exportOptions: {
                                  columns: [0, 1, 2, 3],

                                  format: {
                                      header: function (data) {
                                          return fixPersianForPdf(data);
                                      },

                                      body: function (data) {
                                          return fixPersianForPdf(data);
                                      }
                                  }
                              },

                            customize: function (doc) {
                                doc.defaultStyle.font = 'Vazir';
                                doc.defaultStyle.alignment = 'right';

                                doc.styles.title = {
                                    font: 'Vazir',
                                    fontSize: 16,
                                    bold: true,
                                    alignment: 'right',
                                    margin: [0, 0, 0, 15]
                                };

                                doc.styles.tableHeader = {
                                    font: 'Vazir',
                                    bold: true,
                                    fontSize: 11,
                                    alignment: 'right'
                                };

                                const table = doc.content[1];

                                table.table.widths = ['10%', '25%', '45%', '20%'];

                                table.layout = {
                                    hLineWidth: function () {
                                        return 0.8;
                                    },

                                    vLineWidth: function () {
                                        return 0.8;
                                    },

                                    hLineColor: function () {
                                        return '#444';
                                    },

                                    vLineColor: function () {
                                        return '#444';
                                    },

                                    paddingLeft: function () {
                                        return 5;
                                    },

                                    paddingRight: function () {
                                        return 5;
                                    },

                                    paddingTop: function () {
                                        return 5;
                                    },

                                    paddingBottom: function () {
                                        return 5;
                                    }
                                };

                                table.table.body.forEach(function (row) {
                                    row.forEach(function (cell, index) {
                                        const text =
                                            typeof cell === 'string'
                                                ? cell
                                                : (cell?.text ?? '');

                                        row[index] = {
                                            text: text,
                                            font: 'Vazir',
                                            alignment: 'right',
                                            margin: [4, 4, 4, 4]
                                        };
                                    });
                                });
                            }
                          },
                          {
                              extend: 'print',
                              title: 'گزارش خلاصه تردد'
                          }
                      ],

                      initComplete: function () {
                          $('.dt-buttons').hide();

                          $('#reportTable_filter').before(`
                              <div id="customExportButtons" class="btn-group me-3">
                                  <button class="btn btn-outline-primary" id="btnPrint">
                                      پرینت
                                  </button>

                                  <button class="btn btn-outline-success" id="btnExcel">
                                      اکسل
                                  </button>

                                  <button class="btn btn-outline-danger" id="btnPdf">
                                      PDF
                                  </button>
                              </div>
                          `);
                      }
                  });
              });

              $(document).on("click", "#btnExcel", function (e) {
                  e.preventDefault();
                  $(".buttons-excel").click();
              });

              $(document).on("click", "#btnPdf", function (e) {
                  e.preventDefault();
                  $(".buttons-pdf").click();
              });

              $(document).on("click", "#btnPrint", function (e) {
                  e.preventDefault();
                  $(".buttons-print").click();
              });

              $("#btnSearch").on("click", function () {

                  $("#errorBox")
                      .addClass("d-none")
                      .removeClass("alert-warning")
                      .addClass("alert-danger")
                      .html("");

                  $("#loadingBox").removeClass("d-none");

                  const data = {
                      StartDate: $("input[name='StartDate']").val(),
                      EndDate: $("input[name='EndDate']").val(),
                      StartTime: $("input[name='StartTime']").val(),
                      EndTime: $("input[name='EndTime']").val(),
                      EntranceTypes: $("select[name='EntranceTypes']").val()
                  };

                  $.ajax({
                      url: '/AccessControlReports/Report/GetDataReportAjax',
                      type: 'POST',
                      data: data,

                      success: function (res) {
                          reportTable.clear();

                          let rows = res;

                          if (res.data) {
                              rows = res.data;
                          }

                          if (!rows || rows.length === 0) {
                              reportTable.draw();

                              $("#errorBox")
                                  .removeClass("d-none")
                                  .removeClass("alert-danger")
                                  .addClass("alert-warning")
                                  .text("داده‌ای یافت نشد");

                              return;
                          }

                          $.each(rows, function (i, item) {
                              reportTable.row.add([
                                  i + 1,
                                  item.reportDate,
                                  item.entranceType,
                                  '<span class="badge bg-success">' +
                                  item.recordCount +
                                  '</span>'
                              ]);
                          });

                          reportTable.draw();
                      },

                      error: function (xhr) {
                          let message = "خطا در ارتباط با سرور";

                          if (xhr.responseJSON && xhr.responseJSON.message) {
                              message = xhr.responseJSON.message;
                          }

                          $("#errorBox")
                              .removeClass("d-none")
                              .text(message);
                      },

                      complete: function () {
                          $("#loadingBox").addClass("d-none");
                      }
                  });
              });

    </script>
}

