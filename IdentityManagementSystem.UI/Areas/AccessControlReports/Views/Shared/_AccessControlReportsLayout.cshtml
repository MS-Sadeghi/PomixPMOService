@{
    var userName = Context.Session.GetString("UserName");
    var lastName = Context.Session.GetString("UserLastName");
}
<!DOCTYPE html>
<html dir="rtl" data-header-styles="light" data-menu-styles="dark" data-nav-layout="vertical" data-theme-mode="light" data-toggled="close" data-width="fullwidth" lang="fa">
<head>
    <!-- Meta Data -->
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <title>@ViewData["Title"] - سامانه تردد</title>
    <!-- Favicon -->
    <link href="~/assets/images/brand-logos/favicon.ico" rel="icon" type="image/x-icon" />
    <!-- Start::Styles -->
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="~/assets/js/main.js"></script>
    <link href="~/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/assets/css/styles.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/assets/libs/node-waves/waves.min.css" rel="stylesheet" />
    <link href="~/assets/libs/simplebar/simplebar.min.css" rel="stylesheet" />
    <link href="~/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/assets/libs/%40simonwep/pickr/themes/nano.min.css" rel="stylesheet" />
    <link href="~/assets/libs/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" />
    <link href="~/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/assets/libs/%40tarekraafat/autocomplete.js/css/autoComplete.css" rel="stylesheet" />
    <link href="~/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <style>
        /* استایل مدال */
        .support-modal .modal-header {
            border-bottom: none;
            padding: 20px 25px;
        }

            .support-modal .modal-header .btn-close {
                color: white;
                opacity: 0.8;
            }

                .support-modal .modal-header .btn-close:hover {
                    opacity: 1;
                }

        .support-modal .modal-title {
            font-weight: 600;
            font-size: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .support-modal .modal-title i {
                font-size: 24px;
            }

        .support-modal .modal-body {
            padding: 30px 25px;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 16px;
        }

            .support-modal .modal-body .empty-state {
                text-align: center;
            }

                .support-modal .modal-body .empty-state i {
                    font-size: 48px;
                    color: #dee2e6;
                    margin-bottom: 15px;
                    display: block;
                }

        .support-numbers {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
            max-width: 400px;
        }

        .support-number-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 18px;
            background: #f8f9fa;
            border-radius: 10px;
            border: 1px solid #e9ecef;
            transition: all 0.2s;
        }

            .support-number-item:hover {
                background: #e9ecef;
                border-color: #dee2e6;
            }

            .support-number-item i {
                font-size: 20px;
                color: #0d6efd;
                width: 30px;
                text-align: center;
            }

            .support-number-item .number {
                font-weight: 600;
                color: #212529;
                direction: ltr;
                font-size: 14px;
                letter-spacing: 1px;
            }

            .support-number-item .label {
                color: #6c757d;
                font-size: 13px;
            }

        .report-tabs-strip {
            display: flex;
            align-items: center;
            gap: .4rem;
            padding: .5rem .75rem;
            overflow-x: auto;
            border-bottom: 1px solid var(--default-border, #eeedf3);
            background: var(--custom-white, #fff);
        }

        .report-tab-item {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            white-space: nowrap;
            flex: 0 0 auto;
            border: 1px solid transparent;
            border-radius: .35rem;
            padding: .45rem .7rem;
            font-size: .8rem;
            font-weight: 500;
            color: var(--default-text-color, #4b5563);
            text-decoration: none;
            cursor: pointer;
            transition: background-color .15s ease;
        }

            .report-tab-item:hover {
                background: var(--primary01);
                color: var(--primary-color);
                text-decoration: none;
            }

            .report-tab-item.active {
                background: var(--primary01);
                color: var(--primary-color);
                font-weight: 600;
            }

            .report-tab-item i.report-tab-icon {
                font-size: .9rem;
            }

            .report-tab-item .report-tab-close {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                font-size: 11px;
                color: inherit;
                opacity: .6;
            }

                .report-tab-item .report-tab-close:hover {
                    opacity: 1;
                    background: rgba(0, 0, 0, .08);
                }

        .report-tab-pane,
        .report-frame-pane {
            display: none;
        }

            .report-tab-pane.active,
            .report-frame-pane.active {
                display: block;
            }

            .report-frame-pane iframe {
                display: block;
                width: 100%;
                height: calc(100vh - 11.5rem);
                border: 0;
            }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="loader"></div>
    <!-- ========== HEADER ========== -->
